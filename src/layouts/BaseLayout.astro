---
import navigation from '../content/pages/navigation.json';
import footer from '../content/pages/footer.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  currentPath?: string;
}

const { title, description = 'Spigadolce - Authentic Pugliese Cooking Experiences by Riccardina Burdo. Handmade pasta classes, traditional recipes, and stories from Puglia.', image = '/images/general/hero-poster.jpg', currentPath = '' } = Astro.props;
const canonicalUrl = `https://spigadolce.com${currentPath}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Spigadolce" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="header-bg">
    <header class="site-header">
      <div class="site-brand">
        <a href="/" aria-label="Spigadolce home">
          <img src="/images/general/logo.png" alt="Spigadolce" width="525" height="auto" />
        </a>
      </div>
      <div class="header-actions">
        <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu">&#9776;</button>
      </div>
    </header>
  </div>

  <nav class="site-nav closed" id="site-nav" aria-label="Main navigation">
    <ul>
      {navigation.menu.map((item) => (
        <li class={item.children ? 'has-dropdown' : ''}>
          <a href={item.url} class={currentPath === item.url || (item.children && item.children.some(c => currentPath === c.url || currentPath.startsWith(c.url + '/'))) ? 'active' : ''}>
            {item.label}
          </a>
          {item.children && (
            <ul class="dropdown">
              {item.children.map((child) => (
                <li>
                  <a href={child.url} class={currentPath === child.url ? 'active' : ''}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div class="footer-col">
        <img src="/images/general/logo.png" alt="Spigadolce" class="footer-logo" />
      </div>
      <div class="footer-col">
        <h4>Follow Us</h4>
        <div class="footer-social">
          <a href={footer.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href={footer.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href={footer.social.youtube} target="_blank" rel="noopener" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.13C5.12 19.56 12 19.56 12 19.56s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </a>
        </div>
        <p class="footer-contact-info">{footer.email}</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {footer.copyright}</p>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('site-nav');
    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        nav.classList.toggle('closed');
      });
    }

  </script>
</body>
</html>
