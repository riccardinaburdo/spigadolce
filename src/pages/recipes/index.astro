---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const recipesDir = path.join(process.cwd(), 'src/content/recipes');
const recipeFiles = fs.readdirSync(recipesDir).filter(f => f.endsWith('.json'));
const recipes = recipeFiles
  .map(f => JSON.parse(fs.readFileSync(path.join(recipesDir, f), 'utf-8')))
  .sort((a, b) => a.order - b.order);

const categoryOrder = ['Cavatelli', 'Lagane', 'Orecchiette', 'Troccoli'];
const categories = categoryOrder.filter(cat => recipes.some(r => r.category === cat));
---

<BaseLayout title="Recipes | Spigadolce" currentPath="/recipes">
  <div class="page-header">
    <h1>Recipes</h1>
  </div>

  {categories.map((cat) => (
    <section class="section" style="padding-bottom: 1rem;">
      <h3 class="recipe-category-title">{cat}</h3>
      <div style="max-width: var(--max-width); margin: 0 auto; padding: 0 2rem;">
        {recipes.filter(r => r.category === cat).map((r) => (
          <div class="recipe-list-card">
            <img src={r.image} alt={r.title} />
            <div class="recipe-list-body">
              <h3>{r.title}</h3>
              <p class="recipe-desc">{r.description}</p>
              <p class="recipe-times">
                {r.prepTime && <span>Prep: {r.prepTime}</span>}
                {r.cookTime && <span>Cook: {r.cookTime}</span>}
              </p>
              <a href={`/recipes/${r.slug}`} class="btn-view-recipe">View Recipe</a>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
