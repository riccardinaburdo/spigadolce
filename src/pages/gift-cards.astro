---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Gift Cards | Spigadolce" currentPath="/gift-cards">
  <section class="page-header">
    <h1>Gift an Experience</h1>
    <p>The perfect present for anyone who loves Italian food — a hands-on pasta class in London</p>
  </section>

  <section class="section">
    <div class="gift-grid">

      <div class="gift-card">
        <div class="gift-card-top">
          <div class="gift-icon">🎁</div>
          <h3>Group Class</h3>
          <p>A place in one of our scheduled fresh pasta classes</p>
          <div class="gift-price">&pound;55</div>
        </div>
        <div class="gift-card-bottom">
          <ul class="gift-features">
            <li>Valid for 12 months</li>
            <li>Any scheduled class</li>
            <li>Delivered by email</li>
            <li>Personal message included</li>
          </ul>
          <button class="btn-primary gift-buy-btn" data-gift-type="group" data-gift-label="Group Class" data-gift-price="55">Buy Now</button>
        </div>
      </div>

      <div class="gift-card gift-featured">
        <div class="gift-badge">Most Popular</div>
        <div class="gift-card-top">
          <div class="gift-icon">⭐</div>
          <h3>Private Class for Two</h3>
          <p>An exclusive experience for two — choose the date and the menu</p>
          <div class="gift-price">&pound;150</div>
        </div>
        <div class="gift-card-bottom">
          <ul class="gift-features">
            <li>Valid for 12 months</li>
            <li>Choose your date &amp; menu</li>
            <li>Private experience</li>
            <li>Delivered by email</li>
            <li>Personal message included</li>
          </ul>
          <button class="btn-primary gift-buy-btn" data-gift-type="private" data-gift-label="Private Class for Two" data-gift-price="150">Buy Now</button>
        </div>
      </div>

      <div class="gift-card">
        <div class="gift-card-top">
          <div class="gift-icon">💝</div>
          <h3>Custom Amount</h3>
          <p>Choose the amount and let the recipient pick the class</p>
          <div class="gift-price">From &pound;30</div>
        </div>
        <div class="gift-card-bottom">
          <ul class="gift-features">
            <li>Valid for 12 months</li>
            <li>Any amount you choose</li>
            <li>Delivered by email</li>
            <li>Personal message included</li>
          </ul>
          <div class="custom-amount-wrap">
            <label for="custom-amount">Amount (£)</label>
            <input type="number" id="custom-amount" min="30" max="500" placeholder="e.g. 75" />
          </div>
          <button class="btn-primary gift-buy-btn" data-gift-type="custom" data-gift-label="Custom Gift Card" data-gift-price="">Buy Now</button>
        </div>
      </div>

    </div>

    <div class="gift-how" style="margin-top: 4rem;">
      <h2 style="text-align:center; margin-bottom: 2rem;">How It Works</h2>
      <div class="gift-steps">
        <div class="gift-step">
          <div class="gift-step-num">1</div>
          <h4>Choose</h4>
          <p>Pick the gift card that suits the occasion and click "Buy Now"</p>
        </div>
        <div class="gift-step">
          <div class="gift-step-num">2</div>
          <h4>Personalise</h4>
          <p>Add the recipient's name and a personal message</p>
        </div>
        <div class="gift-step">
          <div class="gift-step-num">3</div>
          <h4>Pay &amp; Send</h4>
          <p>Complete the secure payment — the gift card is delivered by email</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Personalisation Modal -->
  <div class="gift-modal-overlay" id="gift-modal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="gift-modal">
      <button class="gift-modal-close" id="gift-modal-close" aria-label="Close">&times;</button>

      <div class="gift-modal-header">
        <div class="gift-modal-icon" id="modal-icon">🎁</div>
        <h2 id="modal-title">Personalise Your Gift</h2>
        <p id="modal-subtitle">Group Class · £55</p>
      </div>

      <div class="gift-modal-body">
        <div class="gift-modal-field">
          <label for="modal-recipient">To <span class="required">*</span></label>
          <input type="text" id="modal-recipient" placeholder="Recipient's name" autocomplete="off" />
        </div>
        <div class="gift-modal-field">
          <label for="modal-message">Personal message <span class="optional">(optional)</span></label>
          <textarea id="modal-message" rows="3" placeholder="e.g. Happy birthday! Enjoy this pasta class 🍝"></textarea>
        </div>
      </div>

      <div class="gift-modal-footer">
        <button class="btn-primary gift-modal-pay" id="gift-modal-pay">
          Continue to Payment →
        </button>
        <p class="gift-modal-secure">🔒 Secure payment via Stripe</p>
      </div>
    </div>
  </div>

</BaseLayout>

<style>
  .gift-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .gift-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .gift-featured {
    border: 3px solid var(--color-gold);
  }
  .gift-badge {
    background: var(--color-gold);
    color: #fff;
    padding: 0.4rem 1.2rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  .gift-card-top {
    padding: 2.5rem 1.5rem 1.5rem;
    flex: 1;
  }
  .gift-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .gift-card h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }
  .gift-card p {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .gift-price {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    color: var(--color-gold);
    font-weight: 700;
  }
  .gift-card-bottom {
    padding: 1rem 1.5rem 2rem;
  }
  .gift-features {
    list-style: none;
    text-align: left;
    margin-bottom: 1.5rem;
  }
  .gift-features li {
    padding: 0.4rem 0;
    font-size: 0.9rem;
    color: #555;
    border-bottom: 1px solid #f5f5f5;
  }
  .gift-features li::before {
    content: '✓ ';
    color: #27ae60;
    font-weight: 700;
  }
  .gift-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .gift-step-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-gold);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.8rem;
    font-weight: 700;
    font-size: 1.1rem;
  }
  .gift-step h4 {
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  .gift-step p {
    font-size: 0.85rem;
    color: #888;
  }
  .custom-amount-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1rem;
    text-align: left;
  }
  .custom-amount-wrap label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #555;
  }
  .custom-amount-wrap input {
    padding: 0.5rem 0.75rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    width: 100%;
    box-sizing: border-box;
  }
  .gift-buy-btn {
    display: block;
    width: 100%;
    text-align: center;
    cursor: pointer;
    border: none;
  }

  /* ===== MODAL ===== */
  .gift-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    backdrop-filter: blur(2px);
  }
  .gift-modal {
    background: #fff;
    border-radius: 20px;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    position: relative;
    overflow: hidden;
    animation: modal-in 0.2s ease;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(16px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .gift-modal-close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    background: none;
    border: none;
    font-size: 1.6rem;
    color: #aaa;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition: color 0.15s;
  }
  .gift-modal-close:hover { color: var(--color-dark); }

  .gift-modal-header {
    background: var(--color-cream);
    padding: 2rem 2rem 1.5rem;
    text-align: center;
    border-bottom: 1px solid #f0ece4;
  }
  .gift-modal-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .gift-modal-header h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-dark);
    margin-bottom: 0.25rem;
  }
  .gift-modal-header p {
    color: #888;
    font-size: 0.9rem;
  }

  .gift-modal-body {
    padding: 1.75rem 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .gift-modal-field label {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .required { color: var(--color-accent); }
  .optional { font-weight: 400; color: #aaa; text-transform: none; letter-spacing: 0; }

  .gift-modal-field input,
  .gift-modal-field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid #e0dbd4;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: var(--font-body);
    color: var(--color-dark);
    background: #fdfcfb;
    box-sizing: border-box;
    transition: border-color 0.15s;
    resize: vertical;
  }
  .gift-modal-field input:focus,
  .gift-modal-field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .gift-modal-footer {
    padding: 1.5rem 2rem 2rem;
    text-align: center;
  }
  .gift-modal-pay {
    width: 100%;
    font-size: 1rem;
    cursor: pointer;
    border: none;
    margin-bottom: 0.75rem;
  }
  .gift-modal-secure {
    font-size: 0.8rem;
    color: #aaa;
    margin: 0;
  }

  @media (max-width: 768px) {
    .gift-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
    }
    .gift-steps {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  let pendingType = '';
  let pendingCustomAmount = '';

  const overlay = document.getElementById('gift-modal')!;
  const closeBtn = document.getElementById('gift-modal-close')!;
  const payBtn = document.getElementById('gift-modal-pay')!;
  const recipientInput = document.getElementById('modal-recipient') as HTMLInputElement;
  const messageInput = document.getElementById('modal-message') as HTMLTextAreaElement;
  const modalIcon = document.getElementById('modal-icon')!;
  const modalSubtitle = document.getElementById('modal-subtitle')!;

  const ICONS: Record<string, string> = { group: '🎁', private: '⭐', custom: '💝' };

  function openModal(type: string, label: string, price: string, customAmount: string) {
    pendingType = type;
    pendingCustomAmount = customAmount;
    modalIcon.textContent = ICONS[type] ?? '🎁';
    const displayPrice = type === 'custom' ? `£${customAmount}` : `£${price}`;
    modalSubtitle.textContent = `${label} · ${displayPrice}`;
    recipientInput.value = '';
    messageInput.value = '';
    (payBtn as HTMLButtonElement).disabled = false;
    payBtn.textContent = 'Continue to Payment →';
    overlay.style.display = 'flex';
    setTimeout(() => recipientInput.focus(), 100);
  }

  function closeModal() {
    overlay.style.display = 'none';
  }

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Buy Now buttons
  document.querySelectorAll<HTMLButtonElement>('[data-gift-type]').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.giftType!;
      const label = btn.dataset.giftLabel!;
      const price = btn.dataset.giftPrice!;

      if (type === 'custom') {
        const input = document.getElementById('custom-amount') as HTMLInputElement;
        const val = parseFloat(input?.value);
        if (!val || val < 30) {
          input?.focus();
          input?.setCustomValidity('Please enter an amount of at least £30');
          input?.reportValidity();
          return;
        }
        openModal(type, label, price, String(val));
      } else {
        openModal(type, label, price, '');
      }
    });
  });

  // Pay button inside modal
  payBtn.addEventListener('click', async () => {
    const recipient = recipientInput.value.trim();
    if (!recipient) {
      recipientInput.focus();
      recipientInput.style.borderColor = 'var(--color-accent)';
      recipientInput.placeholder = 'Please enter a name';
      return;
    }
    recipientInput.style.borderColor = '';

    (payBtn as HTMLButtonElement).disabled = true;
    payBtn.textContent = 'Redirecting to Stripe…';

    try {
      const res = await fetch('/api/create-gift-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          type: pendingType,
          customAmount: pendingCustomAmount || undefined,
          recipientName: recipient,
          message: messageInput.value.trim() || undefined,
        }),
      });
      const text = await res.text();
      let data: any = {};
      try { data = JSON.parse(text); } catch {}
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert(data.error ?? 'Could not start checkout. Please try again.');
        (payBtn as HTMLButtonElement).disabled = false;
        payBtn.textContent = 'Continue to Payment →';
      }
    } catch {
      alert('Network error. Please try again.');
      (payBtn as HTMLButtonElement).disabled = false;
      payBtn.textContent = 'Continue to Payment →';
    }
  });
</script>
