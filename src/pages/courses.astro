---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../content/pages/courses.json';
import { splitEvents } from '../lib/events';

const { upcoming, past } = splitEvents();
---

<BaseLayout title="Courses | Spigadolce" currentPath="/courses" description="Hands-on courses in handmade Pugliese pasta in London with Riccardina Burdo — orecchiette, cavatelli, troccoli and more — for groups, events and private gatherings.">

  <section class="page-header">
    <h1>{data.title}</h1>
    <p class="page-header-sub">{data.intro}</p>
  </section>

  <!-- Upcoming Events -->
  <section class="section">
    <h2>{data.upcomingHeading}</h2>
    {upcoming.length > 0 ? (
      <div class="events-list">
        {upcoming.map((event) => (
        <article class="event-card course-card">
          {event.image && (
            <div class="event-card-img">
              <img src={event.image} alt={event.title} />
            </div>
          )}
          <div class="event-card-badge">{event.placeholder ? 'Coming Soon' : 'Upcoming'}</div>
          <div class="event-card-body">
            {event.festival && <p class="event-festival">{event.festival}</p>}
            <h3 class="event-title">{event.title}</h3>

            <dl class="course-facts">
              {event.date && (<div><dt>Date</dt><dd>{event.date}</dd></div>)}
              {event.time && (<div><dt>Time</dt><dd>{event.time}{event.duration && <span class="course-fact-inline"> · {event.duration}</span>}</dd></div>)}
              {(event.venue || event.address) && (
                <div class="course-fact-wide"><dt>Where</dt><dd>{event.venue}{event.address && <span class="course-fact-sub">{event.address}</span>}</dd></div>
              )}
              {event.price && (<div><dt>Price</dt><dd class="course-price">{event.price}</dd></div>)}
            </dl>

            <p class="event-description">{event.description}</p>

            {event.includes && event.includes.length > 0 && (
              <div class="course-includes">
                <h4>What's included</h4>
                <ul>
                  {event.includes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}

            {event.note && <p class="course-note">{event.note}</p>}

            <div class="event-footer course-footer">
              <div class="course-footer-info">
                {event.price && <span class="course-footer-price">{event.price}</span>}
                <span class="event-tickets-note">{[event.ticketsNote, event.refundPolicy].filter(Boolean).join(' · ')}</span>
              </div>
              {event.ticketsUrl && (
                <a href={event.ticketsUrl} class="btn-primary" {...(event.ticketsUrl.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{event.ticketsLabel || 'Find Out More'}</a>
              )}
            </div>
          </div>
        </article>
        ))}
      </div>
    ) : (
      <p class="events-empty">{data.noUpcomingText}</p>
    )}
  </section>

  <!-- Past Events -->
  {past.length > 0 && (
    <section class="section section-cream">
      <h2>{data.pastHeading}</h2>
      <div class="events-list">
        {past.map((event) => (
        <div class="event-card event-card--past">
          {event.image && (
            <div class="event-card-img">
              <img src={event.image} alt={event.title} />
            </div>
          )}
          <div class="event-card-badge event-card-badge--past">Past</div>
          <div class="event-card-body">
            <p class="event-festival">{event.festival}</p>
            <h3 class="event-title">{event.title}</h3>
            <div class="event-meta">
              <span class="event-meta-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {[event.date, event.time].filter(Boolean).join(' · ')}
              </span>
              <span class="event-meta-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {[event.venue, event.address].filter(Boolean).join(' — ')}
              </span>
            </div>
            <p class="event-description">{event.pastDescription || event.description}</p>
            <div class="event-footer">
              {event.organiser ? (
                <div class="event-organiser">
                  Organised by <a href={event.organiserUrl} target="_blank" rel="noopener">{event.organiser}</a>
                </div>
              ) : <div />}
            </div>
          </div>
        </div>
        ))}
      </div>
    </section>
  )}

  <!-- Association -->
  <section class="section section-warm">
    <div class="association-block">
      <h2>{data.associationHeading}</h2>
      <p>{data.associationText}</p>
      <a href={data.associationUrl} class="btn-text-link" target="_blank" rel="noopener">Visit Pugliesi nel Mondo UK &rarr;</a>
    </div>
  </section>

  <!-- Invite CTA -->
  <section class="section">
    <div class="invite-block">
      <h2>{data.inviteHeading}</h2>
      <p>{data.inviteText}</p>
      <a href="/contact" class="btn-primary">Get in Touch</a>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    background: #fff;
    color: var(--color-dark);
    padding: 4rem 2rem;
    text-align: center;
  }
  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1.2rem;
  }
  .page-header-sub {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.9;
    color: #555;
  }

  .events-empty {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.8;
    color: #555;
  }

  .event-card--past {
    border-left-color: #bbb;
  }

  .event-card-badge--past {
    background: #8a8a8a !important;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .event-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    border-left: 5px solid var(--color-accent);
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 260px 1fr;
    grid-template-rows: auto 1fr;
  }

  .event-card-img {
    grid-row: 1 / -1;
    grid-column: 1;
  }

  .event-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 700px) {
    .event-card {
      grid-template-columns: 1fr;
    }
    .event-card-img {
      grid-row: auto;
      grid-column: 1;
      height: 200px;
    }
  }

  .event-card-badge {
    position: absolute;
    top: 1.2rem;
    right: 1.5rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }

  .event-card-body {
    padding: 2rem 2rem 1.5rem;
  }

  .event-festival {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.4rem;
  }

  .event-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }

  .event-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.2rem;
  }

  .event-meta-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: #555;
    line-height: 1.5;
  }

  .event-meta-item svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-gold);
  }

  .event-description {
    font-size: 1rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--color-warm);
    padding-top: 1.2rem;
  }

  .event-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--color-warm);
    padding-top: 1.2rem;
  }

  .event-organiser {
    font-size: 0.9rem;
    color: #666;
  }

  .event-organiser a {
    color: var(--color-dark);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event-tickets {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .event-tickets-note {
    font-size: 0.85rem;
    color: #888;
  }

  .association-block {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .association-block h2 {
    font-size: 1.8rem;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }

  .association-block p {
    font-size: 1rem;
    line-height: 1.9;
    color: #444;
    margin-bottom: 1.5rem;
  }

  .invite-block {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .invite-block h2 {
    font-size: 1.8rem;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }

  .invite-block p {
    font-size: 1rem;
    line-height: 1.9;
    color: #444;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 600px) {
    .event-footer {
      flex-direction: column;
      align-items: flex-start;
    }
    .event-card-badge {
      position: static;
      display: inline-block;
      margin-bottom: 0.8rem;
    }
  }

  /* Course card: photo across the top, same proportions on every screen */
  .course-card {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto;
  }
  .course-card .event-card-img {
    grid-row: auto;
    grid-column: 1;
    aspect-ratio: 343 / 200;
    height: auto;
  }
  .course-card .event-card-body {
    padding-top: 1.8rem;
  }

  /* Upcoming course card details */
  .course-card .event-description {
    border-top: none;
    padding-top: 0;
  }
  .course-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 1.5rem;
    margin: 1.2rem 0 1.4rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-warm);
    border-bottom: 1px solid var(--color-warm);
  }
  .course-facts div { min-width: 0; }
  .course-fact-wide { grid-column: 1 / -1; }
  .course-facts dt {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 0.2rem;
  }
  .course-facts dd {
    margin: 0;
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.4;
  }
  .course-fact-sub {
    display: block;
    font-weight: 400;
    color: #666;
  }
  .course-fact-inline {
    font-weight: 400;
    color: #666;
  }
  .course-price { font-size: 1.15rem; color: var(--color-accent) !important; }
  .course-includes { margin: 1.2rem 0; }
  .course-includes h4 {
    font-size: 1rem;
    margin-bottom: 0.6rem;
  }
  .course-includes ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }
  .course-includes li {
    position: relative;
    padding-left: 1.6rem;
    line-height: 1.5;
  }
  .course-includes li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }
  .course-note {
    font-style: italic;
    color: #555;
    line-height: 1.7;
  }
  .course-footer { align-items: center; }
  .course-footer-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .course-footer-price {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-dark);
  }
  @media (max-width: 500px) {
    .course-facts { grid-template-columns: 1fr; }
  }
</style>
