---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const classesDir = path.join(process.cwd(), 'src/content/cooking-classes');
const classFiles = fs.readdirSync(classesDir).filter(f => f.endsWith('.json'));
const allClasses = classFiles
  .map(f => JSON.parse(fs.readFileSync(path.join(classesDir, f), 'utf-8')))
  .filter(c => c.type !== 'private')
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const now = new Date();
const upcoming = allClasses.filter(c => c.status === 'upcoming' && new Date(c.date) >= now);
const past = allClasses.filter(c => c.status === 'past' || new Date(c.date) < now).reverse();
---

<BaseLayout title="Restaurant Classes | Spigadolce" currentPath="/cooking-classes">

  <div class="page-header">
    <h1>Restaurant Classes</h1>
    <p>Experience the heart of Italian culinary tradition in our intimate, home-style cooking classes. Set in a warm, welcoming kitchen environment, these hands-on sessions capture the authentic essence of Italian family cooking, where recipes and techniques are passed down through generations.</p>
  </div>

  <!-- Perfect For -->
  <section class="section section-warm" style="text-align:center; padding: 2.5rem 2rem;">
    <h2 style="font-family: var(--font-heading); font-size: 1.6rem; color: var(--color-dark); margin-bottom: 1.2rem;">Perfect For</h2>
    <div class="occasions-tags" style="max-width:900px; margin:0 auto;">
      <span class="occasion-tag">Dinner parties</span>
      <span class="occasion-tag">Birthdays</span>
      <span class="occasion-tag">Team building</span>
      <span class="occasion-tag">Date nights</span>
      <span class="occasion-tag">Anniversary celebrations</span>
      <span class="occasion-tag">Hen parties</span>
    </div>
  </section>

  <!-- Upcoming Classes or Coming Soon teaser -->
  {upcoming.length > 0 ? (
    <section class="section section-cream">
      <h2>Upcoming Classes</h2>
      <p class="subtitle">Book your spot before they fill up</p>
      <div class="classes-grid">
        {upcoming.map((c) => (
          <a href={`/cooking-classes/${c.slug}`} class="class-card upcoming-card">
            <div class="class-card-img-wrapper">
              <img src={c.image} alt={c.title} width="640" height="220" loading="lazy" />
              <span class="class-badge badge-available">AVAILABLE</span>
            </div>
            <div class="class-card-body">
              <p class="date">{new Date(c.date).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <h3>{c.subtitle ?? c.title}</h3>
              <p class="location">{c.location}</p>
              <p class="price">&pound;{c.price} <small>/person</small></p>
            </div>
            <div class="class-card-actions">
              <span class="status-upcoming">Book Now</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="coming-soon-box">
        <div class="coming-soon-icon">🍽️</div>
        <h2>New Classes Coming Soon</h2>
        <p>We're organising a new cycle of classes at a prestigious Pugliese restaurant in London. A special setting for an even more authentic experience.</p>
        <p class="coming-soon-tagline">Stay tuned — dates coming soon.</p>
      </div>
    </section>
  )}

  <!-- Past Classes -->
  {past.length > 0 && (
    <section class="section">
      <h2>Past Classes</h2>
      <p class="subtitle">A look back at our previous classes</p>
      <div class="classes-grid">
        {past.map((c) => (
          <a href={`/cooking-classes/${c.slug}`} class="class-card">
            <div class="class-card-img-wrapper">
              <img src={c.image} alt={c.title} width="640" height="220" loading="lazy" />
            </div>
            <div class="class-card-body">
              <p class="date">{new Date(c.date).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <h3>{c.subtitle ?? c.title}</h3>
              <p class="location">{c.location}</p>
            </div>
            <div class="class-card-actions">
              <span class="status-past">Past Event</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .page-header p {
    max-width: 760px;
    margin: 0.8rem auto 0;
    color: #555;
    line-height: 1.7;
    font-size: 1rem;
  }
  .class-card-actions {
    padding: 0 1.5rem 1.5rem;
  }
  .classes-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .classes-grid .class-card {
    flex: 0 1 340px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .class-card-img-wrapper img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 12px 12px 0 0;
    display: block;
  }
  .coming-soon-box {
    max-width: 560px;
    margin: 0 auto;
    border: 2px dashed var(--color-accent);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    text-align: center;
    background: #fff;
  }
  .coming-soon-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    filter: grayscale(0.4);
  }
  .coming-soon-box h2 {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--color-dark);
    margin-bottom: 0.8rem;
  }
  .coming-soon-box p {
    color: #555;
    line-height: 1.7;
    max-width: 420px;
    margin: 0 auto 0.5rem;
  }
  .coming-soon-tagline {
    color: var(--color-accent) !important;
    font-style: italic;
    font-weight: 600;
    margin-top: 1rem !important;
  }
</style>
