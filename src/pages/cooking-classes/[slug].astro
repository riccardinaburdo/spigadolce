---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const classesDir = path.join(process.cwd(), 'src/content/cooking-classes');
  const classFiles = fs.readdirSync(classesDir).filter(f => f.endsWith('.json'));
  return classFiles.map(f => {
    const data = JSON.parse(fs.readFileSync(path.join(classesDir, f), 'utf-8'));
    return { params: { slug: data.slug }, props: { classData: data } };
  });
}

const { classData: c } = Astro.props;

const gallery = c.gallery ?? [c.image];
const coverImage = c.coverImage ?? c.image;
const formattedDate = new Date(c.date).toLocaleDateString('en-GB', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout title={`${c.title} | Spigadolce`} currentPath="/cooking-classes">

  <!-- Main layout -->
  <div class="private-layout" style="padding-top: 5rem;">

    <!-- Gallery -->
    <div class="private-gallery">
      <div class="gallery-main">
        <img id="gallery-main-img" src={coverImage} alt={c.title} />
      </div>
      {/* Real thumbnails */}
      {gallery.length > 1 && (
        <div class="gallery-thumbs">
          {gallery.map((img: string, i: number) => (
            <button
              class={`gallery-thumb${i === 0 ? ' active' : ''}`}
              data-src={img}
              aria-label={`View image ${i + 1}`}
            >
              <img src={img} alt={`${c.title} — image ${i + 1}`} />
            </button>
          ))}
        </div>
      )}
      {/* Grey placeholders when no gallery images */}
      {gallery.length === 0 && c.galleryCount > 0 && (
        <div class="gallery-thumbs">
          {Array.from({ length: c.galleryCount }).map((_: unknown, i: number) => (
            <div class="gallery-thumb gallery-thumb-placeholder" aria-label={`Photo ${i + 1} coming soon`}>
              <span class="gallery-placeholder-icon">📷</span>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="private-content">
      <p class="private-tag">Cooking Class</p>
      <h1>{c.subtitle ?? c.title}</h1>
      <p class="private-intro">{c.description}</p>

      <!-- Meta info -->
      <div class="class-meta-grid">
        <div class="class-meta-cell">
          <span class="class-meta-label">Date</span>
          <span class="class-meta-value">{formattedDate}</span>
          {c.time && <span class="class-meta-sub">{c.time}</span>}
        </div>
        <div class="class-meta-cell">
          <span class="class-meta-label">Location</span>
          <span class="class-meta-value">{c.location}</span>
          {c.address && <span class="class-meta-sub">{c.address}</span>}
        </div>
        <div class="class-meta-cell">
          <span class="class-meta-label">Price</span>
          <span class="class-meta-value">£{c.price} <small>/ person</small></span>
        </div>
        {c.duration && (
          <div class="class-meta-cell">
            <span class="class-meta-label">Duration</span>
            <span class="class-meta-value">{c.duration}</span>
          </div>
        )}
      </div>

      <!-- Long description -->
      {c.longDescription && c.longDescription.map((para: string) => (
        <p class="private-intro">{para}</p>
      ))}

      <!-- Occasions -->
      {c.occasions && (
        <div class="private-occasions">
          <h3>Perfect For</h3>
          <div class="occasions-tags">
            {c.occasions.map((o: string) => <span class="occasion-tag">{o}</span>)}
          </div>
        </div>
      )}

      <!-- Closing note -->
      {c.closingNote && (
        <p class="private-closing-note">🍽️ {c.closingNote}</p>
      )}

      <!-- Allergen Notice -->
      <div class="allergen-notice">
        <div class="allergen-notice-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <strong>Allergen Information</strong>
        </div>
        <p>Our classes involve handling ingredients that contain or may contain the following allergens: <strong>cereals containing gluten</strong> (wheat), <strong>eggs</strong>, <strong>milk</strong>, <strong>nuts</strong>, and <strong>sulphites</strong>. All classes take place in a kitchen environment where cross-contamination cannot be fully excluded.</p>
        <p>If you or any member of your group have a food allergy, intolerance, or dietary requirement, please contact us before booking so we can advise accordingly. We are unable to guarantee a fully allergen-free environment.</p>
        <p class="allergen-contact">Questions? Email <a href="mailto:spigadolce@gmail.com">spigadolce@gmail.com</a> before booking.</p>
      </div>

      <!-- CTA -->
      <div class="booking-cta-block">
        {new Date(c.date) < new Date() ? (
          <span class="status-past">Past Event</span>
        ) : (
          <div class="quantity-booking">
            <div class="qty-selector">
              <label for="qty-select">Spots:</label>
              <select id="qty-select">
                {[1,2,3,4,5,6].map((n) => <option value={n}>{n}</option>)}
              </select>
            </div>
            <button
              class="btn-primary private-cta"
              id="add-to-cart-btn"
              data-slug={c.slug}
              data-title={c.subtitle ?? c.title}
              data-date={c.date}
              data-location={c.location}
              data-price={c.price}
              data-image={c.image}
            >
              Add to Cart · £{c.price}/person
            </button>
          </div>
        )}
      </div>

    </div>
  </div>

</BaseLayout>

<style>
  .quantity-booking {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .qty-selector {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .qty-selector label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-dark);
  }
  .qty-selector select {
    padding: 0.5rem 0.75rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
    background: #fff;
    cursor: pointer;
  }
  .allergen-notice {
    background: #fff8f0;
    border: 1px solid #f0d9c0;
    border-left: 4px solid #e07b2a;
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .allergen-notice-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #c05a00;
  }
  .allergen-notice-header svg {
    flex-shrink: 0;
    color: #c05a00;
  }
  .allergen-notice p {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #5a3a1a;
    margin: 0;
  }
  .allergen-contact {
    font-size: 0.85rem !important;
    color: #7a5030 !important;
  }
  .allergen-contact a {
    color: #c05a00;
    text-decoration: underline;
  }
</style>

<script>
  // Gallery
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');
  const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement;

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src;
      if (src && mainImg) {
        mainImg.src = src;
        thumbs.forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
      }
    });
  });

  // Add to cart
  const addBtn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
  if (addBtn) {
    addBtn.addEventListener('click', () => {
      const qty = parseInt((document.getElementById('qty-select') as HTMLSelectElement)?.value || '1');
      const item = {
        slug: addBtn.dataset.slug!,
        title: addBtn.dataset.title!,
        date: addBtn.dataset.date!,
        location: addBtn.dataset.location!,
        price: parseFloat(addBtn.dataset.price!),
        image: addBtn.dataset.image!,
        quantity: qty,
      };

      let cart: typeof item[] = [];
      try { cart = JSON.parse(localStorage.getItem('spigadolce_cart') || '[]'); } catch {}

      const existing = cart.find(i => i.slug === item.slug);
      if (existing) {
        existing.quantity += qty;
      } else {
        cart.push(item);
      }

      localStorage.setItem('spigadolce_cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));

      addBtn.textContent = '✓ Added to Cart';
      addBtn.style.background = '#27ae60';
      setTimeout(() => {
        addBtn.textContent = `Add to Cart · £${item.price}/person`;
        addBtn.style.background = '';
      }, 2000);
    });
  }
</script>
