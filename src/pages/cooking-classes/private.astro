---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../content/pages/private-classes.json';
import fs from 'node:fs';
import path from 'node:path';

const classesDir = path.join(process.cwd(), 'src/content/cooking-classes');
const classFiles = fs.readdirSync(classesDir).filter(f => f.endsWith('.json'));
const privateClasses = classFiles
  .map(f => JSON.parse(fs.readFileSync(path.join(classesDir, f), 'utf-8')))
  .filter(c => c.type === 'private')
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const now = new Date();
const upcomingPrivate = privateClasses.filter(c => new Date(c.date) >= now);
const pastPrivate = privateClasses.filter(c => new Date(c.date) < now).reverse();

const galleryImages = data.gallery;
---

<BaseLayout title="Private In-Home Classes | Spigadolce" currentPath="/cooking-classes/private">

  <!-- Page Header -->
  <div class="page-header">
    <h1>Private In-Home Classes</h1>
    <p class="subtitle">A personal pasta-making workshop brought directly to your kitchen — for you, your family, or a small group of friends.</p>
  </div>

  <!-- Perfect For -->
  <section class="section section-warm" style="text-align:center; padding: 2.5rem 2rem;">
    <h2 style="font-family: var(--font-heading); font-size: 1.6rem; color: var(--color-dark); margin-bottom: 1.2rem;">Perfect For</h2>
    <div class="occasions-tags" style="max-width:900px; margin:0 auto;">
      {data.occasions.map((o: string) => <span class="occasion-tag">{o}</span>)}
    </div>
  </section>

  <!-- Upcoming Classes -->
  {upcomingPrivate.length > 0 && (
    <section class="section section-cream">
      <h2>Upcoming Classes</h2>
      <p class="subtitle">Book your spot before they fill up</p>
      <div class="classes-grid">
        {upcomingPrivate.map((c) => (
          <a href={`/cooking-classes/${c.slug}`} class="class-card upcoming-card">
            <div class="class-card-img-wrapper">
              <img src={c.image} alt={c.subtitle ?? c.title} width="640" height="220" loading="lazy" />
              <span class="class-badge badge-available">AVAILABLE</span>
            </div>
            <div class="class-card-body">
              <p class="date">{new Date(c.date).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <h3>{c.subtitle ?? c.title}</h3>
              <p class="location">{c.location}</p>
              <p class="price">&pound;{c.price} <small>/person</small></p>
            </div>
            <div class="class-card-actions">
              <span class="status-upcoming">Book Now</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Main layout: gallery + content -->
  <div class="private-layout">

    <!-- Mobile-only title -->
    <div class="private-mobile-header">
      <p class="private-tag">In-Home Experience</p>
      <h1>Experience Authentic Italian Pasta Making in Your Own Kitchen</h1>
    </div>

    <!-- Gallery -->
    <div class="private-gallery">
      <div class="gallery-main">
        <img id="gallery-main-img" src={galleryImages[0]} alt="Pasta making class" width="600" height="450" />
      </div>
      {galleryImages.length > 1 && (
        <div class="gallery-thumbs">
          {galleryImages.map((img: string, i: number) => (
            <button
              class={`gallery-thumb${i === 0 ? ' active' : ''}`}
              data-src={img}
              aria-label={`View image ${i + 1}`}
            >
              <img src={img} alt={`Gallery image ${i + 1}`} />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="private-content">
      <p class="private-tag">In-Home Experience</p>
      <h1>{data.subtitle}</h1>
      <p class="private-intro">{data.intro}</p>

      <div class="class-meta-grid">
        <div class="class-meta-cell">
          <span class="class-meta-label">Group Size</span>
          <span class="class-meta-value">{data.groupSize}</span>
        </div>
        <div class="class-meta-cell">
          <span class="class-meta-label">All-Inclusive</span>
          <span class="class-meta-value">Equipment &amp; ingredients provided</span>
        </div>
      </div>

      <div class="private-detail-block">
        <h3>What You'll Create</h3>
        <ul>
          {data.whatYouCreate.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="private-detail-block">
        <h3>Skills You'll Master</h3>
        <ul>
          {data.skills.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="private-detail-block">
        <h3>What's Included</h3>
        <ul>
          {data.included.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>

      <p class="private-closing-note">🍽️ {data.closingNote}</p>

      <div class="private-booking-cta">
        <a
          class="btn-primary"
          href={`mailto:spigadolce@gmail.com?subject=Private In-Home Class Enquiry&body=Hi Riccardina,%0A%0AI'd like to book a private in-home pasta class.%0A%0APreferred date(s): %0ANumber of people: %0ALocation (postcode): %0AName: %0APhone: %0A%0AThank you!`}
        >
          Book Your Private Class
        </a>
        <a
          class="btn-whatsapp"
          href="https://wa.me/447903903651?text=Hi Riccardina, I'd like to book a private in-home pasta class."
          target="_blank"
          rel="noopener"
        >
          Book via WhatsApp
        </a>
      </div>
    </div>

  </div>

  <!-- Past Classes -->
  {pastPrivate.length > 0 && (
    <section class="section">
      <h2>Past Classes</h2>
      <p class="subtitle">A look back at our previous classes</p>
      <div class="classes-grid">
        {pastPrivate.map((c) => (
          <a href={`/cooking-classes/${c.slug}`} class="class-card">
            <div class="class-card-img-wrapper">
              <img src={c.image} alt={c.title} width="640" height="220" loading="lazy" />
            </div>
            <div class="class-card-body">
              <p class="date">{new Date(c.date).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <h3>{c.subtitle ?? c.title}</h3>
              <p class="location">{c.location}</p>
            </div>
            <div class="class-card-actions">
              <span class="status-past">Past Event</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .class-card-actions {
    padding: 0 1.5rem 1.5rem;
  }
  .classes-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  .classes-grid .class-card {
    flex: 0 1 340px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .class-card-img-wrapper img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 12px 12px 0 0;
    display: block;
  }
  .private-booking-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #25D366;
    color: #fff;
    border-radius: 8px;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-whatsapp:hover {
    background: #1ebe5d;
  }
  .private-mobile-header {
    display: none;
  }
  @media (max-width: 768px) {
    .private-mobile-header {
      display: block;
      padding: 1.5rem 1.5rem 0;
    }
  }
</style>

<script>
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');
  const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement;

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.src;
      if (src && mainImg) {
        mainImg.src = src;
        thumbs.forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');
      }
    });
  });
</script>
