---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../content/pages/private-classes.json';
---

<BaseLayout title="Private In-Home Classes | Spigadolce" currentPath="/cooking-classes/private">
  <section class="private-hero">
    <h1>{data.title}</h1>
    <p>{data.description}</p>
  </section>

  <section class="private-details">
    <div class="detail-card">
      <h3>What You Create</h3>
      <ul>
        {data.whatYouCreate.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="detail-card">
      <h3>Skills You Learn</h3>
      <ul>
        {data.skills.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="detail-card">
      <h3>What's Included</h3>
      <ul>
        {data.included.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <div class="occasions">
    {data.occasions.map((o, i) => (
      <span>{o}{i < data.occasions.length - 1 ? ' \u2022' : ''}</span>
    ))}
  </div>

  <section class="section" style="text-align: center;">
    <h2>Book Your Experience</h2>
    <p style="max-width: 500px; margin: 1rem auto 2rem; color: #555;">Group size: {data.groupSize}. Get in touch to arrange your private workshop.</p>
    <a href={data.bookingUrl} class="btn-primary">Contact Us</a>
  </section>
</BaseLayout>
