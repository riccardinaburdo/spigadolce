---
import BaseLayout from '../layouts/BaseLayout.astro';
import amazon from '../content/books/amazon.json';
import appleBooks from '../content/books/books.json';

const published = amazon.books.filter((b) => b.url);
const publishedNames = published.map((b) => b.month);
const publishedLine =
  publishedNames.length > 1
    ? `${publishedNames.slice(0, -1).join(', ')} & ${publishedNames.at(-1)} are published`
    : publishedNames.length === 1
      ? `${publishedNames[0]} is published`
      : 'Coming soon';
---

<BaseLayout
  title="Books | Spigadolce"
  currentPath="/books"
  description="Puglian Cuisine by Riccardina Burdo — seasonal recipes and memories from Southern Italy, one volume for every month of the year. Paperbacks on Amazon and illustrated books for iPad on Apple Books."
  image="/images/books/puglian-cuisine/august-large.jpg"
>
  <div class="books-page">
    <!-- Series header, after the poster -->
    <header class="pc-header">
      <h1 class="pc-title">{amazon.seriesTitle}</h1>
      <p class="pc-subtitle">{amazon.seriesSubtitle}</p>
      <p class="pc-eyebrow">A Year of Puglian Flavours</p>
      <hr class="pc-rule" />
      <h2 class="pc-now">Now Available on Amazon</h2>
    </header>

    <!-- Published volumes -->
    <section class="pc-featured">
      {published.map((book) => (
        <article class="pc-feature">
          <a href={book.url} target="_blank" rel="noopener" class="pc-feature-cover" aria-label={`Puglian Cuisine – ${book.month} on Amazon`}>
            <img src={book.largeImage || book.image} alt={`Puglian Cuisine – ${book.month}, cover`} width="900" height="1165" loading="eager" />
          </a>
          <div class="pc-feature-body">
            <h3 class="pc-feature-month">{book.month}</h3>
            {book.description && <p class="pc-feature-text">{book.description}</p>}
            <p class="pc-feature-meta">{amazon.format}{book.price && <> · <strong>{book.price}</strong></>}</p>
            <a href={book.url} target="_blank" rel="noopener" class="pc-buy">Buy on Amazon</a>
          </div>
        </article>
      ))}
    </section>

    <div class="pc-published">
      <p class="pc-published-line">{publishedLine}</p>
      <p class="pc-published-sub">Discover the complete 12-volume collection</p>
    </div>

    <!-- The collection -->
    <section class="pc-collection">
      <h2 class="pc-section-label">The Collection</h2>
      <ul class="pc-grid">
        {amazon.books.map((book) => (
          <li class:list={['pc-tile', { 'is-soon': !book.url }]}>
            {book.url ? (
              <a href={book.url} target="_blank" rel="noopener">
                <img src={book.image} alt={`Puglian Cuisine – ${book.month}`} width="460" height="595" loading="lazy" />
                <span class="pc-tile-label pc-tile-label--live">Available</span>
              </a>
            ) : (
              <>
                <img src={book.image} alt={`Puglian Cuisine – ${book.month}, coming soon`} width="460" height="595" loading="lazy" />
                <span class="pc-tile-label">Coming soon</span>
              </>
            )}
          </li>
        ))}
      </ul>

      <hr class="pc-rule pc-rule--wide" />
      <p class="pc-monthly">New volumes released monthly</p>
      <p class="pc-monthly-sub">Explore the books and order your copy on Amazon</p>
      <a href={amazon.seriesUrl} target="_blank" rel="noopener" class="pc-shop">Shop the series on Amazon</a>
      <p class="pc-author">Riccardina Burdo</p>
    </section>

    <!-- iPad books -->
    <section class="pc-ipad">
      <p class="pc-eyebrow">For iPad &amp; Mac</p>
      <h2 class="pc-ipad-title">Illustrated books on Apple Books</h2>
      <p class="pc-ipad-intro">My first cookbooks were made for iPad: interactive monthly volumes of Pugliese recipes, in Italian, English and Japanese.</p>
      <ul class="pc-apple-grid">
        {appleBooks.map((book) => (
          <li>
            <a href={book.url} target="_blank" rel="noopener" class="pc-apple">
              <img src={book.image} alt={book.title} loading="lazy" />
              <span class="pc-apple-lang">{book.language}</span>
              <span class="pc-apple-title">{book.title}</span>
              <span class="pc-apple-price">{book.price ? book.price : 'Apple Books'}</span>
              <span class="pc-apple-action">View on Apple Books</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .books-page {
    --pc-cream: #faf7f0;
    --pc-ink: #2f342e;
    --pc-terracotta: #c4654c;
    --pc-sage: #6d8466;
    --pc-line: #d9ccaa;
    background: var(--pc-cream);
    color: var(--pc-ink);
    padding: 4.5rem 1rem 5rem;
  }

  /* Header */
  .pc-header {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .pc-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.3rem, 7vw, 3.6rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pc-ink);
    line-height: 1.1;
  }
  .pc-subtitle {
    font-family: var(--font-heading);
    font-style: italic;
    color: var(--pc-sage);
    font-size: 1.1rem;
    margin-top: 0.6rem;
  }
  .pc-eyebrow {
    margin-top: 1.4rem;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pc-terracotta);
  }
  .pc-rule {
    border: 0;
    border-top: 1px solid var(--pc-line);
    width: min(440px, 80%);
    margin: 1.2rem auto 0;
  }
  .pc-rule--wide {
    width: min(760px, 90%);
    margin-top: 3.5rem;
  }
  .pc-now {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 1.4rem;
    color: var(--pc-ink);
  }

  /* Published volumes */
  .pc-featured {
    max-width: 980px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem 4rem;
  }
  .pc-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .pc-feature-cover {
    display: block;
    width: min(100%, 340px);
    padding: 7px;
    background: #fff;
    border: 1px solid var(--pc-line);
    box-shadow: 0 14px 30px -18px rgba(47, 52, 46, 0.45);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .pc-feature-cover:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 38px -20px rgba(47, 52, 46, 0.5);
  }
  .pc-feature-cover img {
    width: 100%;
    height: auto;
  }
  .pc-feature-body {
    max-width: 380px;
    margin-top: 1.6rem;
  }
  .pc-feature-month {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: 1.9rem;
    color: var(--pc-terracotta);
  }
  .pc-feature-text {
    margin-top: 0.6rem;
    font-size: 0.98rem;
    line-height: 1.75;
    color: #4a4d47;
  }
  .pc-feature-meta {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pc-sage);
  }
  .pc-feature-meta strong {
    color: var(--pc-ink);
  }
  .pc-buy,
  .pc-shop {
    display: inline-block;
    margin-top: 1.1rem;
    padding: 0.8rem 1.8rem;
    background: var(--pc-terracotta);
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s;
  }
  .pc-buy:hover,
  .pc-shop:hover {
    background: #a9523c;
    color: #fff;
  }

  .pc-published {
    text-align: center;
    margin-top: 3.2rem;
  }
  .pc-published-line {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--pc-terracotta);
  }
  .pc-published-sub {
    margin-top: 0.3rem;
    color: var(--pc-ink);
  }

  /* Collection */
  .pc-collection {
    max-width: 980px;
    margin: 2.8rem auto 0;
    text-align: center;
  }
  .pc-section-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pc-sage);
  }
  .pc-grid {
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.6rem 1.4rem;
  }
  .pc-tile {
    position: relative;
  }
  .pc-tile a {
    display: block;
    transition: transform 0.3s;
  }
  .pc-tile a:hover {
    transform: translateY(-4px);
  }
  .pc-tile img {
    width: 100%;
    height: auto;
    box-shadow: 0 8px 18px -14px rgba(47, 52, 46, 0.6);
  }
  .pc-tile.is-soon img {
    opacity: 0.55;
    filter: saturate(0.7);
  }
  .pc-tile-label {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8d8a80;
  }
  .pc-tile-label--live {
    color: var(--pc-terracotta);
    font-weight: 700;
  }
  .pc-monthly {
    margin-top: 1.6rem;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--pc-ink);
  }
  .pc-monthly-sub {
    margin-top: 0.4rem;
    color: var(--pc-sage);
  }
  .pc-author {
    margin-top: 1.3rem;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-sage);
  }

  /* iPad books */
  .pc-ipad {
    max-width: 1060px;
    margin: 5rem auto 0;
    padding-top: 3.5rem;
    border-top: 1px solid var(--pc-line);
    text-align: center;
  }
  .pc-ipad .pc-eyebrow {
    margin-top: 0;
  }
  .pc-ipad-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(1.7rem, 4.5vw, 2.3rem);
    margin-top: 0.4rem;
    color: var(--pc-ink);
  }
  .pc-ipad-intro {
    max-width: 560px;
    margin: 0.8rem auto 0;
    color: #4a4d47;
    line-height: 1.75;
  }
  .pc-apple-grid {
    list-style: none;
    padding: 0;
    margin: 2.2rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 2rem 1.6rem;
  }
  .pc-apple {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .pc-apple img {
    width: 100%;
    aspect-ratio: 367 / 480;
    object-fit: cover;
    box-shadow: 0 10px 22px -16px rgba(47, 52, 46, 0.6);
    transition: transform 0.3s;
  }
  .pc-apple:hover img {
    transform: translateY(-4px);
  }
  .pc-apple-lang {
    margin-top: 0.8rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-sage);
  }
  .pc-apple-title {
    margin-top: 0.25rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1.35;
    flex: 1;
  }
  .pc-apple-price {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: #6b6a63;
  }
  .pc-apple-action {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-terracotta);
  }

  @media (max-width: 820px) {
    .pc-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .books-page {
      padding-top: 3rem;
    }
    .pc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.2rem 0.9rem;
    }
    .pc-apple-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.6rem 1rem;
    }
  }
</style>
