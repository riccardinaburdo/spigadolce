---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../content/pages/home.json';

const steps = home.howItWorks.steps;
const stepIcons = { hands: '🤲', cook: '🍳', feast: '🍷' };
---

<BaseLayout title={home.title} currentPath="/">
  <!-- Hero -->
  <section class="hero" style="background-image: url('/images/general/hero-bg.jpg');">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{home.hero.heading}</h1>
      <p>{home.hero.subheading}</p>
      <div class="hero-buttons">
        <a href={home.hero.ctaUrl} class="btn-primary">{home.hero.cta}</a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section section-warm" style="padding: 3rem 2rem; text-align: center;">
    <p style="max-width: 700px; margin: 0 auto; font-size: 1.1rem; line-height: 1.8; color: var(--color-dark);">{home.intro.text}</p>
  </section>

  <!-- Next Demonstration Banner -->
  <section class="section section-cream">
    <div class="next-demo-banner">
      <div class="next-demo-label">Next Demonstration</div>
      <h2 class="next-demo-title">A Taste of Puglia</h2>
      <p class="next-demo-meta">Saturday 13 June 2026 · 12:00–21:00 · Nag's Head Market, London N7</p>
      <p class="next-demo-sub">Live orecchiette-making demonstrations at the Puglian Italian Fest, organised by Pugliesi nel Mondo UK</p>
      <a href="/demonstrations" class="btn-primary">Find Out More</a>
    </div>
  </section>

  <!-- Pugliesi nel Mondo UK -->
  <section class="section section-warm">
    <div class="assoc-block">
      <img src="/images/pugliesi-nel-mondo.jpg" alt="Pugliesi nel Mondo UK — International Association of Apulians in the World" class="assoc-img" />
      <p class="assoc-eyebrow">Volunteering with</p>
      <h2 class="assoc-title">Pugliesi nel Mondo UK</h2>
      <p class="assoc-text">I am an active volunteer member of Pugliesi nel Mondo UK, a non-profit association promoting the cultural heritage of Apulia in the United Kingdom. I bring my pasta demonstrations to their events — freely and with great joy.</p>
      <a href="/demonstrations" class="btn-text-link">See upcoming demonstrations &rarr;</a>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section-newsletter">
    <div class="newsletter-content">
      <h2>{home.newsletter.heading}</h2>
      <p>{home.newsletter.subheading}</p>
      <form class="newsletter-signup-form" id="newsletterForm">
        <input type="email" id="newsletterEmail" placeholder="Your email..." required />
        <button type="submit" id="newsletterBtn">{home.newsletter.buttonText}</button>
      </form>
      <p id="newsletterMsg" style="display:none; margin-top:0.75rem; font-size:0.95rem;"></p>
    </div>
  </section>

</BaseLayout>

<style>
  /* Next Demo Banner */
  .next-demo-banner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    padding: 2rem;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    border-top: 4px solid var(--color-accent);
  }
  .next-demo-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }
  .next-demo-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--color-dark);
    margin-bottom: 0.6rem;
  }
  .next-demo-meta {
    font-size: 0.95rem;
    color: #555;
    margin-bottom: 0.5rem;
  }
  .next-demo-sub {
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  /* Association Block */
  .assoc-block {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .assoc-img {
    width: 100%;
    max-width: 560px;
    border-radius: 12px;
    margin: 0 auto 1.8rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
  .assoc-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
  .assoc-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    color: var(--color-dark);
    margin-bottom: 0.8rem;
  }
  .assoc-text {
    font-size: 1rem;
    line-height: 1.9;
    color: #555;
    margin-bottom: 1.2rem;
  }

  .first-review-home {
    text-align: center;
    padding: 3rem 2rem;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    border: 2px dashed var(--color-gold);
    max-width: 600px;
    margin: 0 auto;
  }
  .first-review-home .first-review-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .first-review-home h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-dark);
    margin-bottom: 0.8rem;
  }
  .first-review-home p {
    color: #666;
    font-size: 1rem;
    line-height: 1.8;
    margin: 0 auto 1.5rem auto;
  }

  .add-review-invite {
    text-align: center;
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .add-review-invite p {
    color: #666;
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .reviews-grid-home {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .review-card-home {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .review-stars-home {
    color: #f1c40f;
    font-size: 1.2rem;
    letter-spacing: 2px;
  }
  .review-text-home {
    font-style: italic;
    color: #555;
    font-size: 0.95rem;
    line-height: 1.7;
    flex: 1;
    margin: 0;
  }
  .review-author-home {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .review-name-home {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-dark);
  }
  .review-date-home {
    font-size: 0.8rem;
    color: #999;
  }

  .review-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .review-modal-overlay.active { display: flex; }
  .review-modal {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    width: 100%;
    max-width: 480px;
    position: relative;
  }
  .review-modal h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-dark);
    margin-bottom: 0.3rem;
  }
  .review-modal-desc {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .review-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #999;
    line-height: 1;
  }
  .review-modal label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-dark);
    margin-bottom: 0.4rem;
  }
  .star-rating {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 1.2rem;
    cursor: pointer;
  }
  .star {
    font-size: 2rem;
    color: #ddd;
    transition: color 0.15s;
    user-select: none;
  }
  .star.active { color: #f1c40f; }
  .review-modal input[type="text"],
  .review-modal textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    margin-bottom: 1rem;
    box-sizing: border-box;
    resize: vertical;
  }
  .review-modal-note {
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 1rem;
    text-align: center;
  }
</style>

<script>
  const newsletterForm = document.getElementById('newsletterForm') as HTMLFormElement;
  const newsletterMsg = document.getElementById('newsletterMsg') as HTMLElement;
  const newsletterBtn = document.getElementById('newsletterBtn') as HTMLButtonElement;

  newsletterForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('newsletterEmail') as HTMLInputElement).value;
    newsletterBtn.disabled = true;
    newsletterBtn.textContent = '…';
    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      newsletterMsg.style.display = 'block';
      if (data.success) {
        localStorage.setItem('spigadolce_subscribed', 'true');
        newsletterMsg.style.color = '#27ae60';
        newsletterMsg.textContent = data.alreadySubscribed
          ? 'You\'re already subscribed — great to have you!'
          : 'You\'re subscribed! Thank you.';
        newsletterForm.reset();
      } else {
        newsletterMsg.style.color = '#c0392b';
        newsletterMsg.textContent = 'Something went wrong. Please try again.';
        newsletterBtn.disabled = false;
        newsletterBtn.textContent = 'Subscribe';
      }
    } catch {
      newsletterMsg.style.display = 'block';
      newsletterMsg.style.color = '#c0392b';
      newsletterMsg.textContent = 'Something went wrong. Please try again.';
      newsletterBtn.disabled = false;
      newsletterBtn.textContent = 'Subscribe';
    }
  });

  const openBtn = document.getElementById('openReviewModal');
  const modal = document.getElementById('reviewModal');
  const closeBtn = document.getElementById('reviewModalClose');
  const form = document.getElementById('reviewForm') as HTMLFormElement;
  const stars = document.querySelectorAll('.star');
  const ratingInput = document.getElementById('ratingValue') as HTMLInputElement;

  openBtn?.addEventListener('click', () => modal?.classList.add('active'));
  closeBtn?.addEventListener('click', () => modal?.classList.remove('active'));
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.remove('active');
  });

  stars.forEach((star) => {
    star.addEventListener('click', () => {
      const val = parseInt((star as HTMLElement).dataset.value || '0');
      ratingInput.value = String(val);
      stars.forEach((s, i) => s.classList.toggle('active', i < val));
    });
    star.addEventListener('mouseenter', () => {
      const val = parseInt((star as HTMLElement).dataset.value || '0');
      stars.forEach((s, i) => s.classList.toggle('active', i < val));
    });
  });
  document.getElementById('starRating')?.addEventListener('mouseleave', () => {
    const current = parseInt(ratingInput.value);
    stars.forEach((s, i) => s.classList.toggle('active', i < current));
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const rating = parseInt(ratingInput.value);
    if (rating === 0) { alert('Please select a star rating.'); return; }
    const name = (document.getElementById('reviewName') as HTMLInputElement).value;
    const text = (document.getElementById('reviewText') as HTMLTextAreaElement).value;
    const starsStr = '★'.repeat(rating) + '☆'.repeat(5 - rating);
    const body = `Rating: ${starsStr} (${rating}/5)\nName: ${name}\n\nReview:\n${text}`;
    window.open(`mailto:spigadolce@gmail.com?subject=${encodeURIComponent('New Review from ' + name)}&body=${encodeURIComponent(body)}`);
    modal?.classList.remove('active');
    form.reset();
    ratingInput.value = '0';
    stars.forEach(s => s.classList.remove('active'));
  });
</script>
