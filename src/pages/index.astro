---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../content/pages/home.json';
import booking from '../content/pages/booking.json';
import fs from 'node:fs';
import path from 'node:path';

// Load cooking classes
const classesDir = path.join(process.cwd(), 'src/content/cooking-classes');
const classFiles = fs.readdirSync(classesDir).filter(f => f.endsWith('.json'));
const now = new Date();
const classes = classFiles
  .map(f => JSON.parse(fs.readFileSync(path.join(classesDir, f), 'utf-8')))
  .filter(c => new Date(c.date) >= now)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 3);

const bookingUrl = booking.platform.url || '/contact';
const steps = home.howItWorks.steps;
const stepIcons = { hands: '🤲', cook: '🍳', feast: '🍷' };
const reviews = home.testimonials.items;
const hasReviews = reviews.length > 0;
---

<BaseLayout title={home.title} currentPath="/">
  <!-- Hero -->
  <section class="hero" style="background-image: url('/images/general/hero-bg.jpg');">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{home.hero.heading}</h1>
      <p>{home.hero.subheading}</p>
      <div class="hero-buttons">
        <a href={home.hero.ctaUrl} class="btn-primary">{home.hero.cta}</a>
        <a href={home.hero.ctaSecondaryUrl} class="btn-secondary-hero">{home.hero.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="section section-warm" style="padding: 3rem 2rem; text-align: center;">
    <p style="max-width: 700px; margin: 0 auto; font-size: 1.1rem; line-height: 1.8; color: var(--color-dark);">{home.intro.text}</p>
  </section>

  <!-- Come Funziona -->
  <section class="section">
    <h2>{home.howItWorks.heading}</h2>
    <p class="subtitle">{home.howItWorks.subheading}</p>
    <div class="steps-grid">
      {steps.map((step) => (
        <div class="step-card">
          <div class="step-icon">{stepIcons[step.icon]}</div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Prossimi Corsi -->
  <section class="section section-cream">
    <h2>Upcoming Classes</h2>
    <p class="subtitle">Choose your experience and book your spot</p>
    {classes.length > 0 ? (
      <div class="classes-grid">
        {classes.map((c, i) => (
          <a href={booking.platform.url || `/cooking-classes/${c.slug}`} target={booking.platform.url ? '_blank' : '_self'} rel="noopener" class="class-card upcoming-card">
            <div class="class-card-img-wrapper">
              <img src={c.image} alt={c.title} />
              <span class={`class-badge ${i === 0 ? 'badge-last' : 'badge-available'}`}>
                {i === 0 ? 'LAST SPOTS' : 'AVAILABLE'}
              </span>
            </div>
            <div class="class-card-body">
              <p class="date">{new Date(c.date).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <h3>{c.title}</h3>
              <p class="location">{c.location}</p>
              <p class="price">&pound;{c.price} <small>/person</small></p>
              <span class="status-upcoming">Book Now</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p style="text-align: center; color: var(--color-dark); opacity: 0.7;">New dates coming soon. Sign up to our newsletter to be the first to know.</p>
    )}
    <div style="text-align: center; margin-top: 2rem;">
      <a href="/cooking-classes" class="btn-text-link">View all classes &rarr;</a>
    </div>
  </section>

  <!-- Come vuoi cucinare -->
  <section class="section">
    <h2>Your Class, Your Way</h2>
    <p class="subtitle">Every experience is tailored to you. Choose the setting that suits you best — I'll bring the passion, the recipes, and everything you need.</p>
    <div class="booking-options-grid">

      <div class="booking-option-card">
        <div class="booking-option-icon">🏠</div>
        <h3>At Your Home</h3>
        <p>I come to you, wherever you are in London. A personal, relaxed experience in your own kitchen — for you, your family, or a small group of friends. No fuss, just good food and great company.</p>
        <a href="/contact" class="btn-primary">Enquire Now</a>
      </div>

      <div class="booking-option-card">
        <div class="booking-option-icon">🫶</div>
        <h3>In a Home Setting</h3>
        <p>Cook together in a warm, welcoming kitchen with a family feel. Small groups, genuine atmosphere, hands in the dough. The most authentic way to experience Pugliese cooking.</p>
        <a href="/contact" class="btn-primary">Enquire Now</a>
      </div>

      <div class="booking-option-card">
        <div class="booking-option-icon">🎉</div>
        <h3>Private Venue</h3>
        <p>Organise a class in a rented space — ideal for team building, birthdays, hen parties, or any group celebration. I take care of the food and the fun; you bring the appetite.</p>
        <a href="/contact" class="btn-primary">Enquire Now</a>
      </div>

    </div>
  </section>

  <!-- Testimoniali -->
  <section class="section section-warm">
    <h2>{home.testimonials.heading}</h2>
    <p class="subtitle">{home.testimonials.subheading}</p>
    {hasReviews ? (
      <div>
        <div class="reviews-grid-home">
          {reviews.map((r: any) => (
            <div class="review-card-home">
              <div class="review-stars-home">
                {'★'.repeat(r.rating ?? 5)}{'☆'.repeat(5 - (r.rating ?? 5))}
              </div>
              <p class="review-text-home">"{r.text}"</p>
              <div class="review-author-home">
                <span class="review-name-home">{r.author}</span>
                {r.date && <span class="review-date-home">{r.date}</span>}
              </div>
            </div>
          ))}
        </div>
        <div class="add-review-invite">
          <p>Enjoyed a class? We'd love to hear from you.</p>
          <button class="btn-primary" id="openReviewModal">Leave a Review</button>
        </div>
      </div>
    ) : (
      <div class="first-review-home">
        <div class="first-review-icon">✍️</div>
        <h3>Be the first to share your experience</h3>
        <p>Every class is a small journey into the flavours and traditions of Puglia. If you've joined one of our sessions, we'd love to hear what you thought — your words help others discover what Spigadolce is all about.</p>
        <button class="btn-primary" id="openReviewModal">Leave a Review</button>
      </div>
    )}
  </section>

  <!-- Review Modal -->
  <div class="review-modal-overlay" id="reviewModal">
    <div class="review-modal">
      <button class="review-modal-close" id="reviewModalClose">&times;</button>
      <h3>Share Your Experience</h3>
      <p class="review-modal-desc">Your words help others discover what Spigadolce is all about.</p>
      <form id="reviewForm">
        <label>Your rating</label>
        <div class="star-rating" id="starRating">
          <span class="star" data-value="1">★</span>
          <span class="star" data-value="2">★</span>
          <span class="star" data-value="3">★</span>
          <span class="star" data-value="4">★</span>
          <span class="star" data-value="5">★</span>
        </div>
        <input type="hidden" id="ratingValue" value="0" />
        <input type="text" id="reviewName" placeholder="Your name" required />
        <textarea id="reviewText" placeholder="Tell us about your experience..." rows="4" required></textarea>
        <p class="review-modal-note">We'll review your submission before publishing it.</p>
        <button type="submit" class="btn-primary" style="width:100%">Send Review</button>
      </form>
    </div>
  </div>

  <!-- Newsletter -->
  <section class="section-newsletter">
    <div class="newsletter-content">
      <h2>{home.newsletter.heading}</h2>
      <p>{home.newsletter.subheading}</p>
      <form class="newsletter-signup-form">
        <input type="email" placeholder="Your email..." required />
        <button type="submit">{home.newsletter.buttonText}</button>
      </form>
    </div>
  </section>

  <!-- Instagram -->
  <section class="insta-section">
    <div class="insta-header-home">
      <h2>Follow Us on Instagram</h2>
      <a href="https://instagram.com/spigadolce" target="_blank" rel="noopener">@spigadolce</a>
    </div>
    <div class="insta-grid">
      <div class="insta-item" style="background-image: url('/images/cooking-classes/mileto-caffe.jpg')"></div>
      <div class="insta-item" style="background-image: url('/images/cooking-classes/avli-battersea.jpg')"></div>
      <div class="insta-item" style="background-image: url('/images/cooking-classes/my-tortellini-1.jpg')"></div>
      <div class="insta-item" style="background-image: url('/images/cooking-classes/egro.jpg')"></div>
      <div class="insta-item" style="background-image: url('/images/cooking-classes/mileto-2.jpg')"></div>
      <div class="insta-item" style="background-image: url('/images/cooking-classes/my-tortellini-2.jpg')"></div>
    </div>
  </section>
</BaseLayout>

<style>
  .first-review-home {
    text-align: center;
    padding: 3rem 2rem;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    border: 2px dashed var(--color-gold);
    max-width: 600px;
    margin: 0 auto;
  }
  .first-review-home .first-review-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .first-review-home h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-dark);
    margin-bottom: 0.8rem;
  }
  .first-review-home p {
    color: #666;
    font-size: 1rem;
    line-height: 1.8;
    margin: 0 auto 1.5rem auto;
  }

  /* ADD REVIEW INVITE (when reviews exist) */
  .add-review-invite {
    text-align: center;
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .add-review-invite p {
    color: #666;
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  /* REVIEW CARDS (home) */
  .reviews-grid-home {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .review-card-home {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .review-stars-home {
    color: #f1c40f;
    font-size: 1.2rem;
    letter-spacing: 2px;
  }
  .review-text-home {
    font-style: italic;
    color: #555;
    font-size: 0.95rem;
    line-height: 1.7;
    flex: 1;
    margin: 0;
  }
  .review-author-home {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .review-name-home {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-dark);
  }
  .review-date-home {
    font-size: 0.8rem;
    color: #999;
  }

  /* MODAL */
  .review-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .review-modal-overlay.active { display: flex; }
  .review-modal {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    width: 100%;
    max-width: 480px;
    position: relative;
  }
  .review-modal h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-dark);
    margin-bottom: 0.3rem;
  }
  .review-modal-desc {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .review-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #999;
    line-height: 1;
  }
  .review-modal label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-dark);
    margin-bottom: 0.4rem;
  }
  .star-rating {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 1.2rem;
    cursor: pointer;
  }
  .star {
    font-size: 2rem;
    color: #ddd;
    transition: color 0.15s;
    user-select: none;
  }
  .star.active { color: #f1c40f; }
  .review-modal input[type="text"],
  .review-modal textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    margin-bottom: 1rem;
    box-sizing: border-box;
    resize: vertical;
  }
  .review-modal-note {
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 1rem;
    text-align: center;
  }
</style>

<script>
  const openBtn = document.getElementById('openReviewModal');
  const modal = document.getElementById('reviewModal');
  const closeBtn = document.getElementById('reviewModalClose');
  const form = document.getElementById('reviewForm') as HTMLFormElement;
  const stars = document.querySelectorAll('.star');
  const ratingInput = document.getElementById('ratingValue') as HTMLInputElement;

  openBtn?.addEventListener('click', () => modal?.classList.add('active'));
  closeBtn?.addEventListener('click', () => modal?.classList.remove('active'));
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.remove('active');
  });

  stars.forEach((star) => {
    star.addEventListener('click', () => {
      const val = parseInt((star as HTMLElement).dataset.value || '0');
      ratingInput.value = String(val);
      stars.forEach((s, i) => s.classList.toggle('active', i < val));
    });
    star.addEventListener('mouseenter', () => {
      const val = parseInt((star as HTMLElement).dataset.value || '0');
      stars.forEach((s, i) => s.classList.toggle('active', i < val));
    });
  });
  document.getElementById('starRating')?.addEventListener('mouseleave', () => {
    const current = parseInt(ratingInput.value);
    stars.forEach((s, i) => s.classList.toggle('active', i < current));
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const rating = parseInt(ratingInput.value);
    if (rating === 0) { alert('Please select a star rating.'); return; }
    const name = (document.getElementById('reviewName') as HTMLInputElement).value;
    const text = (document.getElementById('reviewText') as HTMLTextAreaElement).value;
    const starsStr = '★'.repeat(rating) + '☆'.repeat(5 - rating);
    const body = `Rating: ${starsStr} (${rating}/5)\nName: ${name}\n\nReview:\n${text}`;
    window.open(`mailto:spigadolce@gmail.com?subject=${encodeURIComponent('New Review from ' + name)}&body=${encodeURIComponent(body)}`);
    modal?.classList.remove('active');
    form.reset();
    ratingInput.value = '0';
    stars.forEach(s => s.classList.remove('active'));
  });
</script>
