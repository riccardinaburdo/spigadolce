---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../content/pages/home.json';
import booking from '../content/pages/booking.json';
import fs from 'node:fs';
import path from 'node:path';

// Load cooking classes
const classesDir = path.join(process.cwd(), 'src/content/cooking-classes');
const classFiles = fs.readdirSync(classesDir).filter(f => f.endsWith('.json'));
const classes = classFiles
  .map(f => JSON.parse(fs.readFileSync(path.join(classesDir, f), 'utf-8')))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// Load recipes
const recipesDir = path.join(process.cwd(), 'src/content/recipes');
const recipeFiles = fs.readdirSync(recipesDir).filter(f => f.endsWith('.json'));
const recipes = recipeFiles
  .map(f => JSON.parse(fs.readFileSync(path.join(recipesDir, f), 'utf-8')))
  .sort((a, b) => a.order - b.order)
  .slice(0, 3);

// Load press
const pressItems = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'src/content/press/press.json'), 'utf-8')).slice(0, 2);

const now = new Date();
const bookingUrl = booking.platform.url || '/contact';
---

<BaseLayout title={home.title} currentPath="/">
  <!-- Hero -->
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline poster="/images/general/hero-poster.jpg">
      <source src="/images/general/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{home.hero.heading}</h1>
      <p>{home.hero.subheading}</p>
      <a href={home.hero.ctaUrl} class="btn-primary">{home.hero.cta}</a>
    </div>
  </section>

  <!-- Intro -->
  <section class="section section-warm" style="padding: 3rem 2rem; text-align: center;">
    <p style="max-width: 700px; margin: 0 auto; font-size: 1.1rem; line-height: 1.8; color: var(--color-dark);">{home.intro.text}</p>
  </section>

  <!-- Cooking Classes -->
  <section class="section">
    <h2>Cooking Classes</h2>
    <p class="subtitle">Learn the art of handmade pasta in London</p>
    <div class="classes-grid">
      {classes.map((c) => {
        const isUpcoming = new Date(c.date) >= now;
        return (
          <a href={isUpcoming ? bookingUrl : `/cooking-classes/${c.slug}`} target={isUpcoming && booking.platform.url ? '_blank' : '_self'} rel="noopener" class={`class-card ${isUpcoming ? 'upcoming-card' : ''}`}>
            <img src={c.image} alt={c.title} />
            <div class="class-card-body">
              <p class="date">{new Date(c.date).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>
              <h3>{c.title}</h3>
              <p class="location">{c.location}</p>
              <p class="price">&pound;{c.price} / person</p>
              {isUpcoming ? <span class="status-upcoming">Book Now</span> : <span class="status-past">Past Event</span>}
            </div>
          </a>
        );
      })}
    </div>
    <div style="text-align: center; margin-top: 2rem;">
      <a href="/cooking-classes" class="btn-primary">View All Classes</a>
    </div>
  </section>

  <!-- Recipes -->
  <section class="section section-cream">
    <h2>Recipes</h2>
    <p class="subtitle">Traditional Pugliese pasta recipes</p>
    <div class="recipes-grid" style="max-width: var(--max-width); margin: 0 auto; padding: 0 2rem;">
      {recipes.map((r) => (
        <a href={`/recipes/${r.slug}`} class="recipe-card">
          <img src={r.image} alt={r.title} />
          <div class="recipe-card-overlay">
            <p class="category">{r.category}</p>
            <h3>{r.title}</h3>
          </div>
        </a>
      ))}
    </div>
    <div style="text-align: center; margin-top: 2rem;">
      <a href="/recipes" class="btn-primary">All Recipes</a>
    </div>
  </section>

  <!-- Press -->
  <section class="section">
    <h2>As Seen In</h2>
    <div class="press-grid" style="max-width: 800px; margin: 2rem auto 0;">
      {pressItems.map((p) => (
        <a href={p.url} target="_blank" rel="noopener" class="press-card">
          <img src={p.image} alt={p.outlet} />
          <div class="press-card-body">
            <p class="outlet">{p.outlet}</p>
            <h3>{p.title}</h3>
            <p class="date">{new Date(p.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
