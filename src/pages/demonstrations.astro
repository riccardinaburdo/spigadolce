---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../content/pages/demonstrations.json';
---

<BaseLayout title="Demonstrations | Spigadolce" currentPath="/demonstrations">

  <section class="page-header">
    <h1>{data.title}</h1>
    <p class="page-header-sub">{data.intro}</p>
  </section>

  <!-- Upcoming Events -->
  <section class="section">
    <h2>{data.upcomingHeading}</h2>
    <div class="events-list">
      {data.events.map((event) => (
        <div class="event-card">
          <div class="event-card-badge">Upcoming</div>
          <div class="event-card-body">
            <p class="event-festival">{event.festival}</p>
            <h3 class="event-title">{event.title}</h3>
            <div class="event-meta">
              <span class="event-meta-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {event.date} · {event.time}
              </span>
              <span class="event-meta-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {event.venue} — {event.address}
              </span>
            </div>
            <p class="event-description">{event.description}</p>
            <div class="event-footer">
              <div class="event-organiser">
                Organised by <a href={event.organiserUrl} target="_blank" rel="noopener">{event.organiser}</a>
              </div>
              <div class="event-tickets">
                <span class="event-tickets-note">{event.ticketsNote}</span>
                <a href={event.ticketsUrl} class="btn-primary" target="_blank" rel="noopener">Find Out More</a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Association -->
  <section class="section section-warm">
    <div class="association-block">
      <h2>{data.associationHeading}</h2>
      <p>{data.associationText}</p>
      <a href={data.associationUrl} class="btn-text-link" target="_blank" rel="noopener">Visit Pugliesi nel Mondo UK &rarr;</a>
    </div>
  </section>

  <!-- Invite CTA -->
  <section class="section">
    <div class="invite-block">
      <h2>{data.inviteHeading}</h2>
      <p>{data.inviteText}</p>
      <a href="/contact" class="btn-primary">Get in Touch</a>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    background: var(--color-dark);
    color: #fff;
    padding: 4rem 2rem;
    text-align: center;
  }
  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1.2rem;
  }
  .page-header-sub {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.9;
    opacity: 0.88;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .event-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    border-left: 5px solid var(--color-accent);
    position: relative;
    overflow: hidden;
  }

  .event-card-badge {
    position: absolute;
    top: 1.2rem;
    right: 1.5rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }

  .event-card-body {
    padding: 2rem 2rem 1.5rem;
  }

  .event-festival {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.4rem;
  }

  .event-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }

  .event-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.2rem;
  }

  .event-meta-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: #555;
    line-height: 1.5;
  }

  .event-meta-item svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-gold);
  }

  .event-description {
    font-size: 1rem;
    line-height: 1.8;
    color: #444;
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--color-warm);
    padding-top: 1.2rem;
  }

  .event-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--color-warm);
    padding-top: 1.2rem;
  }

  .event-organiser {
    font-size: 0.9rem;
    color: #666;
  }

  .event-organiser a {
    color: var(--color-dark);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event-tickets {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .event-tickets-note {
    font-size: 0.85rem;
    color: #888;
  }

  .association-block {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .association-block h2 {
    font-size: 1.8rem;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }

  .association-block p {
    font-size: 1rem;
    line-height: 1.9;
    color: #444;
    margin-bottom: 1.5rem;
  }

  .invite-block {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .invite-block h2 {
    font-size: 1.8rem;
    color: var(--color-dark);
    margin-bottom: 1rem;
  }

  .invite-block p {
    font-size: 1rem;
    line-height: 1.9;
    color: #444;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 600px) {
    .event-footer {
      flex-direction: column;
      align-items: flex-start;
    }
    .event-card-badge {
      position: static;
      display: inline-block;
      margin-bottom: 0.8rem;
    }
  }
</style>
