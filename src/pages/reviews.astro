---
import BaseLayout from '../layouts/BaseLayout.astro';

const pressItems = [
  {
    publication: "Telebari",
    date: "16 July 2025",
    title: "Dina, the queen of orecchiette: from Puglia to London",
    quote: "She teaches the tradition of fresh Puglian pasta to international students.",
    url: "https://www.telebari.it/storie/217433-dina-signora-delle-orecchiette-dalla-puglia-a-londra-per-insegnare-agli-stranieri-larte-della-pasta-fresca-foto.html",
    image: "/images/press/telebari.jpg"
  },
  {
    publication: "The Guardian",
    date: "9 June 2025",
    title: "Readers' most treasured kitchen objects",
    quote: "My humble spatula made it to the spotlight… a piece of my roots — and of my family's story.",
    url: "https://www.theguardian.com/lifeandstyle/2025/jun/09/readers-kitchen-treasures-pot-dish-objects",
    image: "/images/press/guardian.jpg"
  },
  {
    publication: "Priscio Podcast",
    date: "1 May 2025",
    title: "Le orecchiette volano a Londra — Riccardina Burdo di Spigadolce",
    quote: "She brought the art of handmade Pugliese pasta to London, teaching authentic orecchiette and sharing the flavours of Southern Italy.",
    url: "https://www.youtube.com/watch?v=ORfugMMZW9o",
    image: "https://img.youtube.com/vi/ORfugMMZW9o/maxresdefault.jpg",
    isVideo: true
  },
  {
    publication: "Londra Sera",
    date: "27 May 2024",
    title: "From Puglia to London with a passion for cooking",
    quote: "From an architecture degree to handmade pasta: the journey from Andria to London.",
    url: "/images/press/londra-sera-article.jpg",
    image: "/images/press/londra-sera.jpg"
  },
  {
    publication: "Andria Viva",
    date: "24 May 2024",
    title: "Da Andria a Londra, l'architetto Riccardina Burdo che produce orecchiette",
    quote: "«Ho presentato le mie orecchiette in un ristorante locale, non immaginavo che avrebbero riscosso un successo immediato»",
    url: "https://www.andriaviva.it/notizie/da-andria-a-londra-riccardina-bruno/",
    image: "/images/press/andria-viva.jpg"
  },
  {
    publication: "Gambero Rosso",
    date: "21 May 2024",
    title: "The Puglian architect selling orecchiette in London",
    quote: "I feel more English than Italian, but I love my roots.",
    url: "https://www.gamberorosso.it/notizie/storie/riccardina-pugliese-orecchiette-londra/",
    image: "/images/press/gambero-rosso.jpg"
  }
];
---

<BaseLayout title="Press | Spigadolce" currentPath="/reviews">

  <section class="page-header">
    <h1>Press</h1>
    <p>Spigadolce in the media</p>
  </section>

  <section class="section" style="max-width: 800px; margin: 0 auto;">
    <div class="press-list">
      {pressItems.map((item) => (
        <div class="press-card">
          <div class="press-thumb-wrapper">
            <img src={item.image} alt={item.publication} class="press-thumb" />
            {item.isVideo && (
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="press-play-overlay" aria-label="Watch video">
                <svg viewBox="0 0 68 48" width="48" height="34"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
              </a>
            )}
          </div>
          <div class="press-body">
            <div class="press-header">
              <span class="press-publication">{item.publication}</span>
              <span class="press-date">{item.date}</span>
            </div>
            <p class="press-title">{item.title}</p>
            <p class="press-quote">"{item.quote}"</p>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="press-link">{item.isVideo ? 'Watch the video →' : 'Read the full article →'}</a>
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    padding: 3rem 2rem;
    text-align: center;
    background: #fff;
  }
  .page-header h1 {
    font-size: 2.5rem;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
  }
  .page-header p {
    color: #888;
    font-size: 1rem;
  }

  .press-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .press-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    border-left: 4px solid var(--color-gold);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .press-thumb-wrapper {
    position: relative;
    width: 200px;
    min-width: 200px;
    height: 133px;
    flex-shrink: 0;
  }
  .press-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .press-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.2);
    transition: background 0.2s;
  }
  .press-play-overlay:hover { background: rgba(0,0,0,0.35); }
  .press-body {
    padding: 1.5rem 1.8rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .press-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .press-publication {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .press-date {
    font-size: 0.8rem;
    color: #999;
    white-space: nowrap;
  }
  .press-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-dark);
    margin-bottom: 0.4rem;
  }
  .press-quote {
    font-style: italic;
    color: #555;
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 0.8rem 0;
  }
  .press-link {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .press-link:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    .press-card { flex-direction: column; align-items: stretch; }
    .press-thumb-wrapper { width: 100%; height: 180px; min-width: unset; }
  }
</style>
