---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../content/pages/home.json';

const testimonials = home.testimonials.items;

const pressItems = [
  {
    publication: "Gambero Rosso",
    date: "21 May 2024",
    title: "L'architetta pugliese che vende orecchiette a Londra",
    quote: "Mi sento più inglese che italiana, ma amo le mie origini",
    url: "https://www.gamberorosso.it"
  },
  {
    publication: "The Guardian",
    date: "9 June 2025",
    title: "Readers' most treasured kitchen objects",
    quote: "My humble spatula made it to the spotlight… a piece of my roots — and of my family's story.",
    url: "https://www.theguardian.com"
  },
  {
    publication: "Londra Sera",
    date: "27 May 2024",
    title: "Dalla Puglia a Londra con la passione per la cucina",
    quote: "Dal diploma in architettura alla pasta fatta a mano: il viaggio da Andria a Londra.",
    url: "https://www.londrasera.com"
  },
  {
    publication: "Telebari",
    date: "16 July 2025",
    title: "Dina, signora delle orecchiette: dalla Puglia a Londra",
    quote: "Insegna la tradizione della pasta fresca pugliese a studenti internazionali.",
    url: "https://www.telebari.it"
  }
];
---

<BaseLayout title="Press & Reviews | Spigadolce" currentPath="/reviews">

  <section class="page-header">
    <h1>Press & Reviews</h1>
    <p>What the press and our guests say about Spigadolce</p>
  </section>

  <section class="section" style="max-width: 800px; margin: 0 auto;">

    <!-- PRESS SECTION -->
    <h2 class="section-title">In the Press</h2>
    <div class="press-list">
      {pressItems.map((item) => (
        <div class="press-card">
          <div class="press-header">
            <span class="press-publication">{item.publication}</span>
            <span class="press-date">{item.date}</span>
          </div>
          <p class="press-title">{item.title}</p>
          <p class="press-quote">"{item.quote}"</p>
        </div>
      ))}
    </div>

    <!-- GUEST REVIEWS SECTION -->
    <h2 class="section-title" style="margin-top: 3.5rem;">What Our Guests Say</h2>
    <div class="reviews-list">
      {testimonials.map((t) => (
        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"{t.text}"</p>
          <div class="review-author">
            <div class="review-avatar">{t.author.charAt(0)}</div>
            <div>
              <p class="review-name">{t.author}</p>
              <p class="review-date">{t.date}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div style="text-align: center; margin-top: 3rem; padding: 2rem; background: var(--color-warm); border-radius: 12px;">
      <h3 style="font-family: var(--font-heading); margin-bottom: 0.5rem;">Attended a class?</h3>
      <p style="color: #666; margin-bottom: 1rem;">We'd love to hear about your experience.</p>
      <a href="/contact" class="btn-primary">Leave a Review</a>
    </div>

  </section>
</BaseLayout>

<style>
  .section-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--color-dark);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-warm);
  }

  /* PRESS */
  .press-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .press-card {
    background: #fff;
    padding: 1.8rem 2rem;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    border-left: 4px solid var(--color-gold);
  }
  .press-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .press-publication {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .press-date {
    font-size: 0.8rem;
    color: #999;
  }
  .press-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
  }
  .press-quote {
    font-style: italic;
    color: #555;
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  /* REVIEWS */
  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .review-card {
    background: #fff;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
  }
  .review-stars {
    color: #f1c40f;
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .review-text {
    font-size: 1.05rem;
    color: #444;
    line-height: 1.8;
    font-style: italic;
    margin-bottom: 1.2rem;
  }
  .review-author {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .review-avatar {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: var(--color-warm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--color-gold);
    font-size: 1.2rem;
  }
  .review-name {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .review-date {
    font-size: 0.8rem;
    color: #999;
  }
</style>
