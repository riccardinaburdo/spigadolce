---
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../content/pages/home.json';

const pressItems = [
  {
    publication: "Gambero Rosso",
    date: "21 May 2024",
    title: "The Puglian architect selling orecchiette in London",
    quote: "I feel more English than Italian, but I love my roots.",
    url: "https://www.gamberorosso.it/notizie/storie/riccardina-pugliese-orecchiette-londra/",
    image: "https://spigadolce.com/cdn/shop/files/precchiette-1-768x512_copy.jpg?v=1716458765"
  },
  {
    publication: "The Guardian",
    date: "9 June 2025",
    title: "Readers' most treasured kitchen objects",
    quote: "My humble spatula made it to the spotlight… a piece of my roots — and of my family's story.",
    url: "https://www.theguardian.com/lifeandstyle/2025/jun/09/readers-kitchen-treasures-pot-dish-objects",
    image: "https://spigadolce.com/cdn/shop/files/Guardian-9-6-2025.jpg?v=1749494145"
  },
  {
    publication: "Londra Sera",
    date: "27 May 2024",
    title: "From Puglia to London with a passion for cooking",
    quote: "From an architecture degree to handmade pasta: the journey from Andria to London.",
    url: "https://www.facebook.com/londrasera/posts/pfbid02tPzP1MMjXuKpy6UhZbE7iMFwv8gaL1PdJe8tqguMp127ws7ybu5JnaufEib4obGtl",
    image: "https://spigadolce.com/cdn/shop/files/Londra-sera-titolo.jpg?v=1739276564"
  },
  {
    publication: "Telebari",
    date: "16 July 2025",
    title: "Dina, the queen of orecchiette: from Puglia to London",
    quote: "She teaches the tradition of fresh Puglian pasta to international students.",
    url: "https://www.telebari.it/storie/217433-dina-signora-delle-orecchiette-dalla-puglia-a-londra-per-insegnare-agli-stranieri-larte-della-pasta-fresca-foto.html",
    image: "https://spigadolce.com/cdn/shop/files/Screenshot-2025-07-16-at-08.30.32.jpg?v=1752651189"
  },
  {
    publication: "Priscio Podcast",
    date: "1 May 2025",
    title: "Le orecchiette volano a Londra — Riccardina Burdo di Spigadolce",
    quote: "She brought the art of handmade Pugliese pasta to London, teaching authentic orecchiette and sharing the flavours of Southern Italy.",
    url: "https://www.youtube.com/watch?v=ORfugMMZW9o",
    image: "https://img.youtube.com/vi/ORfugMMZW9o/maxresdefault.jpg",
    isVideo: true
  }
];

const reviews = home.testimonials.items;
const hasReviews = reviews.length > 0;
---

<BaseLayout title="Press & Reviews | Spigadolce" currentPath="/reviews">

  <section class="page-header">
    <h1>Press & Reviews</h1>
    <p>What the press and our guests say about Spigadolce</p>
  </section>

  <section class="section" style="max-width: 800px; margin: 0 auto;">

    <!-- PRESS SECTION -->
    <h2 class="section-title">In the Press</h2>
    <div class="press-list">
      {pressItems.map((item) => (
        <div class="press-card">
          <div class="press-thumb-wrapper">
            <img src={item.image} alt={item.publication} class="press-thumb" />
            {item.isVideo && (
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="press-play-overlay" aria-label="Watch video">
                <svg viewBox="0 0 68 48" width="48" height="34"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#ff0000"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
              </a>
            )}
          </div>
          <div class="press-body">
            <div class="press-header">
              <span class="press-publication">{item.publication}</span>
              <span class="press-date">{item.date}</span>
            </div>
            <p class="press-title">{item.title}</p>
            <p class="press-quote">"{item.quote}"</p>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="press-link">{item.isVideo ? 'Watch the video →' : 'Read the full article →'}</a>
          </div>
        </div>
      ))}
    </div>

    <!-- GUEST REVIEWS SECTION -->
    <h2 class="section-title" style="margin-top: 3.5rem;">What Our Guests Say</h2>

    {hasReviews ? (
      <div>
        <div class="reviews-grid">
          {reviews.map((r: any) => (
            <div class="review-card">
              <div class="review-stars">
                {'★'.repeat(r.rating ?? 5)}{'☆'.repeat(5 - (r.rating ?? 5))}
              </div>
              <p class="review-text">"{r.text}"</p>
              <div class="review-author">
                <span class="review-name">{r.author}</span>
                {r.date && <span class="review-date">{r.date}</span>}
              </div>
            </div>
          ))}
        </div>
        <div class="add-review-invite">
          <p>Enjoyed a class? We'd love to hear from you.</p>
          <button class="btn-primary" id="openReviewModal">Leave a Review</button>
        </div>
      </div>
    ) : (
      <div class="first-review-box">
        <div class="first-review-icon">✍️</div>
        <h3>Be the first to share your experience</h3>
        <p>
          Every class is a small journey into the flavours and traditions of Puglia.
          If you've joined one of our sessions, we'd love to hear what you thought —
          your words help others discover what Spigadolce is all about.
        </p>
        <button class="btn-primary" id="openReviewModal">Leave a Review</button>
      </div>
    )}

  </section>

  <!-- Review Modal -->
  <div class="review-modal-overlay" id="reviewModal">
    <div class="review-modal">
      <button class="review-modal-close" id="reviewModalClose">&times;</button>
      <h3>Share Your Experience</h3>
      <p class="review-modal-desc">Your words help others discover what Spigadolce is all about.</p>
      <form id="reviewForm">
        <label>Your rating</label>
        <div class="star-rating" id="starRating">
          <span class="star" data-value="1">★</span>
          <span class="star" data-value="2">★</span>
          <span class="star" data-value="3">★</span>
          <span class="star" data-value="4">★</span>
          <span class="star" data-value="5">★</span>
        </div>
        <input type="hidden" id="ratingValue" value="0" />
        <input type="text" id="reviewName" placeholder="Your name" required />
        <textarea id="reviewText" placeholder="Tell us about your experience..." rows="4" required></textarea>
        <p class="review-modal-note">We'll review your submission before publishing it.</p>
        <button type="submit" class="btn-primary" style="width:100%">Send Review</button>
      </form>
    </div>
  </div>

</BaseLayout>

<style>
  .section-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--color-dark);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-warm);
  }

  /* PRESS */
  .press-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .press-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    border-left: 4px solid var(--color-gold);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }
  .press-thumb-wrapper {
    position: relative;
    width: 140px;
    min-width: 140px;
    flex-shrink: 0;
  }
  .press-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .press-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.2);
    transition: background 0.2s;
  }
  .press-play-overlay:hover { background: rgba(0,0,0,0.35); }
  .press-body {
    padding: 1.5rem 1.8rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .press-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .press-publication {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .press-date {
    font-size: 0.8rem;
    color: #999;
    white-space: nowrap;
  }
  .press-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-dark);
    margin-bottom: 0.4rem;
  }
  .press-quote {
    font-style: italic;
    color: #555;
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 0.8rem 0;
  }
  .press-link {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .press-link:hover { text-decoration: underline; }
  @media (max-width: 600px) {
    .press-card { flex-direction: column; }
    .press-thumb-wrapper { width: 100%; height: 160px; min-width: unset; }
  }

  /* ADD REVIEW INVITE (when reviews exist) */
  .add-review-invite {
    text-align: center;
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .add-review-invite p {
    color: #666;
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  /* REVIEW CARDS */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .review-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .review-stars {
    color: #f1c40f;
    font-size: 1.2rem;
    letter-spacing: 2px;
  }
  .review-text {
    font-style: italic;
    color: #555;
    font-size: 0.95rem;
    line-height: 1.7;
    flex: 1;
    margin: 0;
  }
  .review-author {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .review-name {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-dark);
  }
  .review-date {
    font-size: 0.8rem;
    color: #999;
  }

  /* FIRST REVIEW INVITATION */
  .first-review-box {
    text-align: center;
    padding: 3rem 2rem;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    border: 2px dashed var(--color-gold);
  }
  .first-review-icon { font-size: 2.5rem; margin-bottom: 1rem; }
  .first-review-box h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-dark);
    margin-bottom: 0.8rem;
  }
  .first-review-box p {
    color: #666;
    font-size: 1rem;
    line-height: 1.8;
    max-width: 540px;
    margin: 0 auto 1.5rem auto;
  }

  /* MODAL */
  .review-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .review-modal-overlay.active { display: flex; }
  .review-modal {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    width: 100%;
    max-width: 480px;
    position: relative;
  }
  .review-modal h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-dark);
    margin-bottom: 0.3rem;
  }
  .review-modal-desc {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .review-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: #999;
    line-height: 1;
  }
  .review-modal label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-dark);
    margin-bottom: 0.4rem;
  }
  .star-rating {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 1.2rem;
    cursor: pointer;
  }
  .star {
    font-size: 2rem;
    color: #ddd;
    transition: color 0.15s;
    user-select: none;
  }
  .star.active { color: #f1c40f; }
  .review-modal input[type="text"],
  .review-modal textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    margin-bottom: 1rem;
    box-sizing: border-box;
    resize: vertical;
  }
  .review-modal-note {
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 1rem;
    text-align: center;
  }
</style>

<script>
  const openBtn = document.getElementById('openReviewModal');
  const modal = document.getElementById('reviewModal');
  const closeBtn = document.getElementById('reviewModalClose');
  const form = document.getElementById('reviewForm') as HTMLFormElement;
  const stars = document.querySelectorAll('.star');
  const ratingInput = document.getElementById('ratingValue') as HTMLInputElement;

  openBtn?.addEventListener('click', () => modal?.classList.add('active'));
  closeBtn?.addEventListener('click', () => modal?.classList.remove('active'));
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.remove('active');
  });

  // Star interaction
  stars.forEach((star) => {
    star.addEventListener('click', () => {
      const val = parseInt((star as HTMLElement).dataset.value || '0');
      ratingInput.value = String(val);
      stars.forEach((s, i) => s.classList.toggle('active', i < val));
    });
    star.addEventListener('mouseenter', () => {
      const val = parseInt((star as HTMLElement).dataset.value || '0');
      stars.forEach((s, i) => s.classList.toggle('active', i < val));
    });
  });
  document.getElementById('starRating')?.addEventListener('mouseleave', () => {
    const current = parseInt(ratingInput.value);
    stars.forEach((s, i) => s.classList.toggle('active', i < current));
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const rating = parseInt(ratingInput.value);
    if (rating === 0) { alert('Please select a star rating.'); return; }
    const name = (document.getElementById('reviewName') as HTMLInputElement).value;
    const text = (document.getElementById('reviewText') as HTMLTextAreaElement).value;
    const starsStr = '★'.repeat(rating) + '☆'.repeat(5 - rating);
    const body = `Rating: ${starsStr} (${rating}/5)\nName: ${name}\n\nReview:\n${text}`;
    window.open(`mailto:spigadolce@gmail.com?subject=${encodeURIComponent('New Review from ' + name)}&body=${encodeURIComponent(body)}`);
    modal?.classList.remove('active');
    form.reset();
    ratingInput.value = '0';
    stars.forEach(s => s.classList.remove('active'));
  });
</script>
