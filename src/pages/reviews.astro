---
import BaseLayout from '../layouts/BaseLayout.astro';

const pressItems = [
  {
    publication: "Gambero Rosso",
    date: "21 May 2024",
    title: "The Puglian architect selling orecchiette in London",
    quote: "I feel more English than Italian, but I love my roots.",
    url: "https://www.gamberorosso.it/notizie/storie/riccardina-pugliese-orecchiette-londra/",
    image: "https://spigadolce.com/cdn/shop/files/precchiette-1-768x512_copy.jpg?v=1716458765"
  },
  {
    publication: "The Guardian",
    date: "9 June 2025",
    title: "Readers' most treasured kitchen objects",
    quote: "My humble spatula made it to the spotlight… a piece of my roots — and of my family's story.",
    url: "https://www.theguardian.com/lifeandstyle/2025/jun/09/readers-kitchen-treasures-pot-dish-objects",
    image: "https://spigadolce.com/cdn/shop/files/Guardian-9-6-2025.jpg?v=1749494145"
  },
  {
    publication: "Londra Sera",
    date: "27 May 2024",
    title: "From Puglia to London with a passion for cooking",
    quote: "From an architecture degree to handmade pasta: the journey from Andria to London.",
    url: "https://www.facebook.com/londrasera/posts/pfbid02tPzP1MMjXuKpy6UhZbE7iMFwv8gaL1PdJe8tqguMp127ws7ybu5JnaufEib4obGtl",
    image: "https://spigadolce.com/cdn/shop/files/Londra-sera-titolo.jpg?v=1739276564"
  },
  {
    publication: "Telebari",
    date: "16 July 2025",
    title: "Dina, the queen of orecchiette: from Puglia to London",
    quote: "She teaches the tradition of fresh Puglian pasta to international students.",
    url: "https://www.telebari.it/storie/217433-dina-signora-delle-orecchiette-dalla-puglia-a-londra-per-insegnare-agli-stranieri-larte-della-pasta-fresca-foto.html",
    image: "https://spigadolce.com/cdn/shop/files/Screenshot-2025-07-16-at-08.30.32.jpg?v=1752651189"
  }
];
---

<BaseLayout title="Press & Reviews | Spigadolce" currentPath="/reviews">

  <section class="page-header">
    <h1>Press & Reviews</h1>
    <p>What the press and our guests say about Spigadolce</p>
  </section>

  <section class="section" style="max-width: 800px; margin: 0 auto;">

    <!-- PRESS SECTION -->
    <h2 class="section-title">In the Press</h2>
    <div class="press-list">
      {pressItems.map((item) => (
        <div class="press-card">
          <img src={item.image} alt={item.publication} class="press-thumb" />
          <div class="press-body">
            <div class="press-header">
              <span class="press-publication">{item.publication}</span>
              <span class="press-date">{item.date}</span>
            </div>
            <p class="press-title">{item.title}</p>
            <p class="press-quote">"{item.quote}"</p>
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="press-link">Read the full article →</a>
          </div>
        </div>
      ))}
    </div>

    <!-- GUEST REVIEWS SECTION -->
    <h2 class="section-title" style="margin-top: 3.5rem;">What Our Guests Say</h2>

    <div class="first-review-box">
      <div class="first-review-icon">✍️</div>
      <h3>Be the first to share your experience</h3>
      <p>
        Every class is a small journey into the flavours and traditions of Puglia.
        If you've joined one of our sessions, we'd love to hear what you thought —
        your words help others discover what Spigadolce is all about.
      </p>
      <a href="/contact" class="btn-primary">Leave a Review</a>
    </div>

  </section>
</BaseLayout>

<style>
  .section-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--color-dark);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-warm);
  }

  /* PRESS */
  .press-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .press-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    border-left: 4px solid var(--color-gold);
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }
  .press-thumb {
    width: 140px;
    min-width: 140px;
    object-fit: cover;
    display: block;
  }
  .press-body {
    padding: 1.5rem 1.8rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .press-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .press-publication {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .press-date {
    font-size: 0.8rem;
    color: #999;
    white-space: nowrap;
  }
  .press-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-dark);
    margin-bottom: 0.4rem;
  }
  .press-quote {
    font-style: italic;
    color: #555;
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 0.8rem 0;
  }
  .press-link {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .press-link:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .press-card {
      flex-direction: column;
    }
    .press-thumb {
      width: 100%;
      height: 160px;
      min-width: unset;
    }
  }

  /* FIRST REVIEW INVITATION */
  .first-review-box {
    text-align: center;
    padding: 3rem 2rem;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
    border: 2px dashed var(--color-gold);
  }
  .first-review-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .first-review-box h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-dark);
    margin-bottom: 0.8rem;
  }
  .first-review-box p {
    color: #666;
    font-size: 1rem;
    line-height: 1.8;
    max-width: 540px;
    margin: 0 auto 1.5rem auto;
  }
</style>
