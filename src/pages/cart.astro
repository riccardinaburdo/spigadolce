---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Your Cart | Spigadolce" currentPath="/cart">

  <div class="page-header">
    <h1>Your Cart</h1>
  </div>

  <section class="section">
    <div class="cart-wrapper">

      <!-- Empty state -->
      <div class="cart-empty" id="cart-empty" style="display:none;">
        <div class="cart-empty-icon">🛒</div>
        <h2>Your cart is empty</h2>
        <p>Browse our upcoming classes and add a spot to your cart.</p>
        <a href="/cooking-classes" class="btn-primary" style="display:inline-block; margin-top:1.5rem;">Browse Classes</a>
      </div>

      <!-- Cart content -->
      <div id="cart-content" style="display:none;">
        <div class="cart-items" id="cart-items"></div>

        <div class="cart-summary">
          <div class="cart-subtotal-row">
            <span>Subtotal</span>
            <span id="cart-subtotal">£0</span>
          </div>
          <p class="cart-note">Taxes and fees included. Secure checkout via Stripe.</p>
          <button class="btn-primary cart-checkout-btn" id="cart-checkout-btn">
            Proceed to Checkout
          </button>
          <a href="/cooking-classes" class="cart-continue-link">← Continue browsing</a>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .cart-wrapper {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .cart-empty {
    text-align: center;
    padding: 4rem 2rem;
  }

  .cart-empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    filter: grayscale(0.3);
  }

  .cart-empty h2 {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
    color: var(--color-dark);
  }

  .cart-empty p {
    color: #666;
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .cart-item {
    display: flex;
    gap: 1.5rem;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.07);
    overflow: hidden;
    align-items: stretch;
  }

  .cart-item-img {
    width: 140px;
    min-width: 140px;
    object-fit: cover;
    display: block;
  }

  .cart-item-info {
    flex: 1;
    padding: 1.25rem 1rem;
  }

  .cart-item-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--color-dark);
    margin-bottom: 0.3rem;
  }

  .cart-item-meta {
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .cart-item-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cart-qty-wrap {
    display: flex;
    align-items: center;
    gap: 0;
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
  }

  .cart-qty-btn {
    background: #f5f5f5;
    border: none;
    width: 32px;
    height: 32px;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }

  .cart-qty-btn:hover {
    background: #ebebeb;
  }

  .cart-qty-num {
    width: 36px;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-dark);
    border-left: 1px solid #ddd;
    border-right: 1px solid #ddd;
    height: 32px;
    line-height: 32px;
  }

  .cart-item-remove {
    background: none;
    border: none;
    color: #bbb;
    font-size: 0.82rem;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
    transition: color 0.15s;
  }

  .cart-item-remove:hover {
    color: #e74c3c;
  }

  .cart-item-price {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-dark);
    padding: 1.25rem 1.5rem 1.25rem 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .cart-summary {
    background: var(--color-cream);
    border-radius: 12px;
    padding: 2rem;
    max-width: 400px;
    margin-left: auto;
  }

  .cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 0.5rem;
  }

  .cart-note {
    font-size: 0.82rem;
    color: #888;
    margin-bottom: 1.5rem;
  }

  .cart-checkout-btn {
    width: 100%;
    font-size: 1rem;
    margin-bottom: 1rem;
    cursor: pointer;
    border: none;
  }

  .cart-continue-link {
    display: block;
    text-align: center;
    color: #888;
    font-size: 0.88rem;
    text-decoration: underline;
  }

  .cart-continue-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .cart-item-img {
      width: 100px;
      min-width: 100px;
    }
    .cart-summary {
      margin-left: 0;
      max-width: 100%;
    }
  }
</style>

<script>
  type CartItem = {
    slug: string;
    title: string;
    date: string;
    location: string;
    price: number;
    image: string;
    quantity: number;
  };

  function getCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem('spigadolce_cart') || '[]');
    } catch {
      return [];
    }
  }

  function saveCart(items: CartItem[]) {
    localStorage.setItem('spigadolce_cart', JSON.stringify(items));
    window.dispatchEvent(new Event('cart-updated'));
  }

  function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString('en-GB', {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });
  }

  function renderCart() {
    const items = getCart();
    const emptyEl = document.getElementById('cart-empty')!;
    const contentEl = document.getElementById('cart-content')!;
    const itemsEl = document.getElementById('cart-items')!;
    const subtotalEl = document.getElementById('cart-subtotal')!;

    if (items.length === 0) {
      emptyEl.style.display = 'block';
      contentEl.style.display = 'none';
      return;
    }

    emptyEl.style.display = 'none';
    contentEl.style.display = 'block';

    itemsEl.innerHTML = items.map((item, idx) => `
      <div class="cart-item" data-idx="${idx}">
        <img class="cart-item-img" src="${item.image}" alt="${item.title}" />
        <div class="cart-item-info">
          <p class="cart-item-title">${item.title}</p>
          <p class="cart-item-meta">${formatDate(item.date)}<br>${item.location}</p>
          <div class="cart-item-controls">
            <div class="cart-qty-wrap">
              <button class="cart-qty-btn" data-action="decrease" data-idx="${idx}">−</button>
              <span class="cart-qty-num">${item.quantity}</span>
              <button class="cart-qty-btn" data-action="increase" data-idx="${idx}">+</button>
            </div>
            <button class="cart-item-remove" data-action="remove" data-idx="${idx}">Remove</button>
          </div>
        </div>
        <div class="cart-item-price">£${(item.price * item.quantity).toFixed(2)}</div>
      </div>
    `).join('');

    const total = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
    subtotalEl.textContent = `£${total.toFixed(2)}`;

    // Bind events
    itemsEl.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', () => {
        const action = (btn as HTMLElement).dataset.action!;
        const idx = parseInt((btn as HTMLElement).dataset.idx!);
        const cart = getCart();
        if (action === 'increase') {
          cart[idx].quantity += 1;
          saveCart(cart);
        } else if (action === 'decrease') {
          cart[idx].quantity -= 1;
          if (cart[idx].quantity <= 0) cart.splice(idx, 1);
          saveCart(cart);
        } else if (action === 'remove') {
          cart.splice(idx, 1);
          saveCart(cart);
        }
        renderCart();
      });
    });
  }

  // Checkout
  const checkoutBtn = document.getElementById('cart-checkout-btn')!;
  checkoutBtn?.addEventListener('click', async () => {
    const items = getCart();
    if (items.length === 0) return;

    checkoutBtn.textContent = 'Redirecting…';
    (checkoutBtn as HTMLButtonElement).disabled = true;

    try {
      const res = await fetch('/api/create-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items.map(i => ({ slug: i.slug, quantity: i.quantity })) }),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert('Could not start checkout. Please try again.');
        checkoutBtn.textContent = 'Proceed to Checkout';
        (checkoutBtn as HTMLButtonElement).disabled = false;
      }
    } catch {
      alert('Network error. Please try again.');
      checkoutBtn.textContent = 'Proceed to Checkout';
      (checkoutBtn as HTMLButtonElement).disabled = false;
    }
  });

  renderCart();
</script>
