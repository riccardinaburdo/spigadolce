---
// Static page — auth checked client-side via /api/admin/classes
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Classes Admin · Spigadolce</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --accent: #ff7800;
      --dark: #3B1A0E;
      --green: #27ae60;
      --red: #e74c3c;
      --font-h: 'Playfair Display', serif;
      --font-b: 'Lato', sans-serif;
    }
    body { font-family: var(--font-b); background: #f4f1ed; color: var(--dark); min-height: 100vh; }

    .btn { display: inline-block; padding: 0.8rem 1.75rem; border-radius: 6px; font-size: 0.92rem; font-weight: 700; cursor: pointer; border: none; font-family: var(--font-b); transition: opacity 0.15s; }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-sm { padding: 0.4rem 0.9rem; font-size: 0.82rem; border-radius: 5px; }
    .btn-edit { background: var(--dark); color: #fff; }
    .btn-delete { background: var(--red); color: #fff; }
    .btn-new { background: var(--accent); color: #fff; }
    .btn-cancel { background: #eee; color: #555; }
    .btn-save { background: var(--green); color: #fff; }

    .admin-header { background: var(--dark); color: #fff; padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between; }
    .admin-header h1 { font-family: var(--font-h); font-size: 1.4rem; }
    .admin-header a { color: rgba(255,255,255,0.6); font-size: 0.85rem; text-decoration: none; }
    .admin-header a:hover { color: #fff; }
    .admin-body { max-width: 1100px; margin: 0 auto; padding: 2rem; }

    .toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
    .toolbar h2 { font-family: var(--font-h); font-size: 1.4rem; }
    .status-bar { font-size: 0.85rem; color: #888; }

    .table-wrap { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.07); }
    table { width: 100%; border-collapse: collapse; }
    th { background: #f7f4ef; padding: 0.75rem 1rem; text-align: left; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: #888; font-weight: 700; }
    td { padding: 0.85rem 1rem; border-top: 1px solid #f0ece6; font-size: 0.9rem; vertical-align: middle; }
    tr:hover td { background: #fdf9f5; }
    .badge { display: inline-block; padding: 0.2rem 0.65rem; border-radius: 20px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .badge-upcoming { background: #e8f5e9; color: #2e7d32; }
    .badge-past { background: #f5f5f5; color: #999; }
    .badge-coming-soon { background: #fff3e0; color: #e65100; }
    .badge-private { background: #ede7f6; color: #4527a0; }
    .actions { display: flex; gap: 0.5rem; }
    .empty-row td { text-align: center; padding: 3rem; color: #aaa; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; display: none; align-items: flex-start; justify-content: center; padding: 2rem 1rem; overflow-y: auto; backdrop-filter: blur(2px); }
    .modal-overlay.open { display: flex; }
    .modal { background: #fff; border-radius: 16px; width: 100%; max-width: 1080px; box-shadow: 0 20px 60px rgba(0,0,0,0.2); margin: auto; display: flex; flex-direction: column; }
    .modal-head { padding: 1.5rem 2rem; border-bottom: 1px solid #f0ece6; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
    .modal-head h3 { font-family: var(--font-h); font-size: 1.3rem; }
    .modal-close { background: none; border: none; font-size: 1.5rem; color: #aaa; cursor: pointer; line-height: 1; }
    .modal-close:hover { color: var(--dark); }
    .modal-layout { display: flex; flex: 1; min-height: 0; }
    .modal-body { padding: 1.75rem 2rem; display: flex; flex-direction: column; gap: 1.25rem; overflow-y: auto; max-height: 75vh; flex: 1; min-width: 0; }
    .modal-preview { width: 340px; flex-shrink: 0; background: #f4f1ed; border-left: 1px solid #f0ece6; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; overflow-y: auto; max-height: 75vh; }
    .modal-preview-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #aaa; }
    .modal-foot { padding: 1.25rem 2rem; border-top: 1px solid #f0ece6; display: flex; gap: 0.75rem; justify-content: flex-end; flex-shrink: 0; }

    /* ── CARD PREVIEW (replica fedele del sito) ── */
    .preview-card { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.10); text-decoration: none; color: inherit; display: flex; flex-direction: column; font-family: 'Lato', sans-serif; }
    .preview-card.upcoming { border: 2px solid #ff7800; }
    .preview-img-wrap { position: relative; }
    .preview-img { width: 100%; height: 180px; object-fit: cover; display: block; border-radius: 12px 12px 0 0; }
    .preview-img-placeholder { width: 100%; height: 180px; background: #ddd; border-radius: 12px 12px 0 0; display: flex; align-items: center; justify-content: center; color: #bbb; font-size: 0.78rem; letter-spacing: 0.05em; text-transform: uppercase; }
    .preview-badge { position: absolute; top: 10px; right: 10px; padding: 4px 12px; border-radius: 20px; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #fff; background: #27ae60; }
    .preview-body { padding: 1.1rem 1.2rem; flex: 1; }
    .preview-date { font-size: 0.75rem; color: #f5c211; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
    .preview-title { font-size: 1.05rem; font-family: 'Playfair Display', serif; color: #3B1A0E; margin-bottom: 0.3rem; font-weight: 700; }
    .preview-location { font-size: 0.8rem; color: #888; margin-bottom: 0.6rem; }
    .preview-price { font-size: 1rem; font-weight: 700; color: #ff7800; }
    .preview-price small { font-weight: 400; font-size: 0.8rem; color: #aaa; }
    .preview-actions { padding: 0 1.2rem 1.1rem; }
    .preview-status-upcoming { display: inline-block; font-size: 0.75rem; background: #ff7800; color: #fff; padding: 0.25rem 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
    .preview-status-past { display: inline-block; font-size: 0.7rem; background: #eee; color: #999; padding: 0.2rem 0.6rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .preview-status-soon { display: inline-block; font-size: 0.7rem; background: #fff3e0; color: #e65100; padding: 0.2rem 0.6rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
    @media (max-width: 780px) {
      .modal-layout { flex-direction: column; }
      .modal-preview { width: 100%; border-left: none; border-top: 1px solid #f0ece6; max-height: none; }
    }

    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .field-row.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
    .field { display: flex; flex-direction: column; gap: 0.35rem; }
    .field.full { grid-column: 1 / -1; }
    label { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #666; }
    label .req { color: var(--accent); }
    input[type=text], input[type=number], input[type=date], select, textarea {
      padding: 0.65rem 0.85rem; border: 1.5px solid #ddd; border-radius: 7px; font-size: 0.92rem;
      font-family: var(--font-b); color: var(--dark); background: #fdfcfb; width: 100%; transition: border-color 0.15s;
    }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }
    textarea { resize: vertical; min-height: 80px; }
    .field-hint { font-size: 0.75rem; color: #aaa; margin-top: 0.2rem; }
    .img-field-wrap { display: flex; gap: 0.5rem; align-items: center; }
    .img-field-wrap input { flex: 1; }
    .btn-upload { background: #f0ece6; color: var(--dark); border: 1.5px solid #ddd; border-radius: 7px; padding: 0.6rem 0.85rem; font-size: 0.82rem; font-weight: 700; cursor: pointer; white-space: nowrap; font-family: var(--font-b); transition: background 0.15s; flex-shrink: 0; }
    .btn-upload:hover { background: #e5e0d8; }
    .btn-upload:disabled { opacity: 0.5; cursor: not-allowed; }
    .gallery-upload-row { display: flex; flex-direction: column; gap: 0.5rem; }
    .section-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); padding-bottom: 0.4rem; border-bottom: 1px solid #f0ece6; margin-top: 0.5rem; }

    .toast { position: fixed; bottom: 2rem; right: 2rem; padding: 0.9rem 1.5rem; border-radius: 10px; color: #fff; font-weight: 700; font-size: 0.9rem; z-index: 200; transform: translateY(8px); opacity: 0; transition: all 0.25s; pointer-events: none; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast-ok { background: var(--green); }
    .toast-err { background: var(--red); }

    .deploy-notice { background: #fff8e1; border: 1px solid #ffe082; border-radius: 10px; padding: 0.85rem 1.25rem; font-size: 0.85rem; color: #7b5800; margin-bottom: 1.5rem; display: none; }
    .deploy-notice.show { display: block; }

    @media (max-width: 640px) {
      .field-row, .field-row.cols-3 { grid-template-columns: 1fr; }
      .admin-body { padding: 1rem; }
    }
  </style>
</head>
<body>

<header class="admin-header">
  <h1>Classes Dashboard</h1>
  <a href="/" target="_blank">← View Site</a>
</header>

<div class="admin-body">
  <div class="deploy-notice" id="deploy-notice">
    Changes saved and committed to GitHub. Vercel will redeploy in ~2 minutes.
  </div>

  <div class="toolbar">
    <h2>All Classes</h2>
    <div style="display:flex; gap:0.75rem; align-items:center;">
      <span class="status-bar" id="status-bar">Loading…</span>
      <button class="btn btn-sm btn-new" id="new-btn">+ New Class</button>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Title</th>
          <th>Location</th>
          <th>Price</th>
          <th>Type</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="classes-tbody">
        <tr class="empty-row"><td colspan="7">Loading classes…</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="modal-overlay" id="modal">
  <div class="modal">
    <div class="modal-head">
      <h3 id="modal-title">New Class</h3>
      <button class="modal-close" id="modal-close">&times;</button>
    </div>
    <div class="modal-layout">
    <div class="modal-body">

      <div class="section-title">Basic Info</div>
      <div class="field-row">
        <div class="field">
          <label>Title <span class="req">*</span></label>
          <input type="text" id="f-title" placeholder="e.g. Handmade Pasta Evening" />
        </div>
        <div class="field">
          <label>Subtitle</label>
          <input type="text" id="f-subtitle" placeholder="e.g. Fresh Pasta Workshop" />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Slug <span class="req">*</span></label>
          <input type="text" id="f-slug" placeholder="e.g. handmade-pasta-jan-2026" />
          <span class="field-hint">URL: /cooking-classes/&#123;slug&#125; · auto-generated from title</span>
        </div>
        <div class="field">
          <label>Type</label>
          <select id="f-type">
            <option value="">Restaurant (public)</option>
            <option value="private">Private (in-home)</option>
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Status <span class="req">*</span></label>
          <select id="f-status">
            <option value="upcoming">Upcoming</option>
            <option value="coming-soon">Coming Soon</option>
            <option value="past">Past</option>
          </select>
        </div>
        <div class="field">
          <label>Order</label>
          <input type="number" id="f-order" placeholder="e.g. 30" />
          <span class="field-hint">Higher = more recent</span>
        </div>
      </div>

      <div class="section-title">Schedule &amp; Location</div>
      <div class="field-row cols-3">
        <div class="field">
          <label>Date <span class="req">*</span></label>
          <input type="date" id="f-date" />
        </div>
        <div class="field">
          <label>Time</label>
          <input type="text" id="f-time" placeholder="e.g. 6:30pm" />
        </div>
        <div class="field">
          <label>Duration</label>
          <input type="text" id="f-duration" placeholder="e.g. 2 hours" />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label>Location <span class="req">*</span></label>
          <input type="text" id="f-location" placeholder="e.g. Venue Name, London" />
        </div>
        <div class="field">
          <label>Address</label>
          <input type="text" id="f-address" placeholder="Full address (optional)" />
        </div>
      </div>

      <div class="section-title">Pricing</div>
      <div class="field-row cols-3">
        <div class="field">
          <label>Price (£) <span class="req">*</span></label>
          <input type="number" id="f-price" placeholder="38" min="0" />
        </div>
        <div class="field">
          <label>Currency</label>
          <select id="f-currency">
            <option value="GBP">GBP (£)</option>
            <option value="EUR">EUR (€)</option>
          </select>
        </div>
      </div>

      <div class="section-title">Content</div>
      <div class="field">
        <label>Short Description <span class="req">*</span></label>
        <textarea id="f-description" rows="2" placeholder="Shown on the class card and in the booking email"></textarea>
      </div>
      <div class="field">
        <label>What's Included (one item per line)</label>
        <textarea id="f-includes" rows="3" placeholder="Two-hour pasta-making class&#10;Antipasti and bottomless prosecco&#10;Apron and pasta tools provided"></textarea>
      </div>
      <div class="field">
        <label>What You'll Create (one per line)</label>
        <textarea id="f-whatYouCreate" rows="2" placeholder="Orecchiette&#10;Cavatelli"></textarea>
      </div>
      <div class="field">
        <label>Skills You'll Master (one per line)</label>
        <textarea id="f-skills" rows="2" placeholder="Hand-rolling technique&#10;Shaping without a machine"></textarea>
      </div>
      <div class="field">
        <label>Perfect For (one per line)</label>
        <textarea id="f-occasions" rows="2" placeholder="Birthdays&#10;Date nights&#10;Team building"></textarea>
      </div>

      <div class="section-title">Images</div>
      <div class="field-row">
        <div class="field">
          <label>Main Image <span class="req">*</span></label>
          <div class="img-field-wrap">
            <input type="text" id="f-image" placeholder="/images/cooking-classes/photo.jpg" />
            <button type="button" class="btn-upload" id="upload-image-btn">Upload</button>
          </div>
          <input type="file" id="upload-image-file" accept="image/*" style="display:none" />
        </div>
        <div class="field">
          <label>Cover Image (optional)</label>
          <div class="img-field-wrap">
            <input type="text" id="f-coverImage" placeholder="/images/cooking-classes/cover.jpg" />
            <button type="button" class="btn-upload" id="upload-cover-btn">Upload</button>
          </div>
          <input type="file" id="upload-cover-file" accept="image/*" style="display:none" />
        </div>
      </div>
      <div class="field">
        <label>Gallery Images (one path per line)</label>
        <div class="gallery-upload-row">
          <textarea id="f-gallery" rows="2" placeholder="/images/cooking-classes/img1.jpg&#10;/images/cooking-classes/img2.jpg"></textarea>
          <div>
            <button type="button" class="btn-upload" id="upload-gallery-btn">Upload &amp; Add to Gallery</button>
            <input type="file" id="upload-gallery-file" accept="image/*" multiple style="display:none" />
          </div>
        </div>
      </div>

    </div>
    </div><!-- end modal-body -->

    <!-- PREVIEW PANEL -->
    <div class="modal-preview">
      <div class="modal-preview-label">Anteprima scheda</div>
      <div class="preview-card" id="preview-card">
        <div class="preview-img-wrap">
          <div class="preview-img-placeholder" id="preview-img-placeholder">Nessuna immagine</div>
          <img class="preview-img" id="preview-img" src="" alt="" style="display:none" />
          <span class="preview-badge" id="preview-badge" style="display:none">Available</span>
        </div>
        <div class="preview-body">
          <p class="preview-date" id="preview-date">Giorno, mese anno</p>
          <p class="preview-title" id="preview-title">Titolo della classe</p>
          <p class="preview-location" id="preview-location">Luogo, Città</p>
          <p class="preview-price" id="preview-price">£— <small>/person</small></p>
        </div>
        <div class="preview-actions">
          <span id="preview-status" class="preview-status-upcoming">Book Now</span>
        </div>
      </div>
      <p style="font-size:0.72rem; color:#bbb; line-height:1.5;">L'anteprima riflette la scheda che apparirà nella pagina Classes. Clicca <strong>Pubblica</strong> per salvare e inviare al sito.</p>
    </div>

    </div><!-- end modal-layout -->

    <div class="modal-foot">
      <button class="btn btn-sm btn-cancel" id="modal-cancel">Annulla</button>
      <button class="btn btn-sm btn-save" id="modal-save">Pubblica</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // Auth check: if /api/admin/classes returns 401, redirect to login
  async function init() {
    const res = await fetch('/api/admin/classes');
    if (res.status === 401) {
      window.location.href = '/gestione';
      return;
    }
    const allClassesInit = await res.json();
    allClasses = Array.isArray(allClassesInit) ? allClassesInit : [];
    statusBar.textContent = allClasses.length + ' classes';
    renderTable();
  }

  type ClassItem = Record<string, any> & { _sha?: string; _filename?: string };

  let allClasses: ClassItem[] = [];
  let editingSlug: string | null = null;
  let editingSha: string | null = null;

  const tbody      = document.getElementById('classes-tbody') as HTMLTableSectionElement;
  const statusBar  = document.getElementById('status-bar') as HTMLElement;
  const newBtn     = document.getElementById('new-btn') as HTMLButtonElement;
  const modal      = document.getElementById('modal') as HTMLElement;
  const modalTitle = document.getElementById('modal-title') as HTMLElement;
  const modalClose = document.getElementById('modal-close') as HTMLButtonElement;
  const modalCancel= document.getElementById('modal-cancel') as HTMLButtonElement;
  const modalSave  = document.getElementById('modal-save') as HTMLButtonElement;
  const toastEl    = document.getElementById('toast') as HTMLElement;
  const deployNote = document.getElementById('deploy-notice') as HTMLElement;

  function toast(msg: string, ok = true) {
    toastEl.textContent = msg;
    toastEl.className = 'toast ' + (ok ? 'toast-ok' : 'toast-err');
    toastEl.classList.add('show');
    setTimeout(() => toastEl.classList.remove('show'), 3500);
  }

  function slugify(str: string) {
    return str.toLowerCase()
      .replace(/[àáâãäå]/g, 'a').replace(/[èéêë]/g, 'e').replace(/[ìíîï]/g, 'i')
      .replace(/[òóôõö]/g, 'o').replace(/[ùúûü]/g, 'u')
      .replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-').trim();
  }

  function badgeHtml(status: string, type: string) {
    const typeBadge = type === 'private' ? '<span class="badge badge-private">Private</span>' : '';
    const map: Record<string, string> = {
      upcoming: '<span class="badge badge-upcoming">Upcoming</span>',
      'coming-soon': '<span class="badge badge-coming-soon">Coming Soon</span>',
      past: '<span class="badge badge-past">Past</span>',
    };
    return (map[status] || '<span class="badge">' + status + '</span>') + (typeBadge ? ' ' + typeBadge : '');
  }

  function renderTable() {
    if (allClasses.length === 0) {
      tbody.innerHTML = '<tr class="empty-row"><td colspan="7">No classes yet. Click "+ New Class" to add one.</td></tr>';
      return;
    }
    tbody.innerHTML = allClasses.map(c =>
      '<tr>' +
      '<td>' + (c.date ? new Date(c.date).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'}) : '—') + '</td>' +
      '<td><strong>' + (c.subtitle || c.title || '—') + '</strong></td>' +
      '<td>' + (c.location || '—') + '</td>' +
      '<td>' + (c.price ? '£' + c.price : '—') + '</td>' +
      '<td>' + (c.type === 'private' ? 'Private' : 'Restaurant') + '</td>' +
      '<td>' + badgeHtml(c.status, c.type || '') + '</td>' +
      '<td><div class="actions">' +
        '<button class="btn btn-sm btn-edit" data-slug="' + c.slug + '">Edit</button>' +
        '<button class="btn btn-sm btn-delete" data-slug="' + c.slug + '" data-sha="' + (c._sha || '') + '">Delete</button>' +
      '</div></td>' +
      '</tr>'
    ).join('');

    tbody.querySelectorAll<HTMLElement>('.btn-edit[data-slug]').forEach(btn => {
      btn.addEventListener('click', () => openEdit(btn.dataset.slug!));
    });
    tbody.querySelectorAll<HTMLElement>('.btn-delete[data-slug]').forEach(btn => {
      btn.addEventListener('click', () => deleteClass(btn.dataset.slug!, btn.dataset.sha!));
    });
  }

  async function loadClasses() {
    statusBar.textContent = 'Loading…';
    const res = await fetch('/api/admin/classes');
    if (res.status === 401) { window.location.href = '/gestione'; return; }
    if (!res.ok) { statusBar.textContent = 'Error loading classes'; return; }
    allClasses = await res.json();
    statusBar.textContent = allClasses.length + ' classes';
    renderTable();
  }

  function openModal(title: string) {
    modalTitle.textContent = title;
    modal.classList.add('open');
  }

  function closeModal() {
    modal.classList.remove('open');
    editingSlug = null;
    editingSha = null;
  }

  modalClose.addEventListener('click', closeModal);
  modalCancel.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  function getField(id: string): string {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
    return el ? el.value.trim() : '';
  }
  function setField(id: string, val: string) {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
    if (el) el.value = val ?? '';
  }
  function toLines(val: string): string[] {
    return val.split('\n').map(s => s.trim()).filter(Boolean);
  }

  function clearForm() {
    ['f-title','f-subtitle','f-slug','f-status','f-type','f-order',
     'f-date','f-time','f-duration','f-location','f-address',
     'f-price','f-currency','f-description','f-includes',
     'f-whatYouCreate','f-skills','f-occasions','f-image','f-coverImage','f-gallery'].forEach(id => setField(id, ''));
    setField('f-status', 'upcoming');
    setField('f-currency', 'GBP');
  }

  // ── LIVE PREVIEW ──
  const previewCard      = document.getElementById('preview-card') as HTMLElement;
  const previewImg       = document.getElementById('preview-img') as HTMLImageElement;
  const previewImgPh     = document.getElementById('preview-img-placeholder') as HTMLElement;
  const previewBadge     = document.getElementById('preview-badge') as HTMLElement;
  const previewDate      = document.getElementById('preview-date') as HTMLElement;
  const previewTitle     = document.getElementById('preview-title') as HTMLElement;
  const previewLocation  = document.getElementById('preview-location') as HTMLElement;
  const previewPrice     = document.getElementById('preview-price') as HTMLElement;
  const previewStatus    = document.getElementById('preview-status') as HTMLElement;

  function updatePreview() {
    const title    = getField('f-subtitle') || getField('f-title') || 'Titolo della classe';
    const date     = getField('f-date');
    const time     = getField('f-time');
    const location = getField('f-location') || 'Luogo, Città';
    const price    = getField('f-price');
    const status   = getField('f-status') || 'upcoming';
    const image    = getField('f-image');

    // Image
    if (image) {
      previewImg.src = image;
      previewImg.style.display = 'block';
      previewImgPh.style.display = 'none';
    } else {
      previewImg.style.display = 'none';
      previewImgPh.style.display = 'flex';
    }

    // Badge
    if (status === 'upcoming') {
      previewBadge.style.display = 'block';
      previewBadge.textContent = 'Available';
    } else {
      previewBadge.style.display = 'none';
    }

    // Date
    if (date) {
      const d = new Date(date + 'T12:00:00');
      const formatted = d.toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
      previewDate.textContent = time ? formatted + ' · ' + time : formatted;
    } else {
      previewDate.textContent = 'Giorno, mese anno';
    }

    previewTitle.textContent = title;
    previewLocation.textContent = location;
    previewPrice.innerHTML = price ? '£' + price + ' <small>/person</small>' : '£— <small>/person</small>';

    // Card border + status
    if (status === 'upcoming') {
      previewCard.classList.add('upcoming');
      previewStatus.className = 'preview-status-upcoming';
      previewStatus.textContent = 'Book Now';
    } else if (status === 'coming-soon') {
      previewCard.classList.remove('upcoming');
      previewStatus.className = 'preview-status-soon';
      previewStatus.textContent = 'Coming Soon';
    } else {
      previewCard.classList.remove('upcoming');
      previewStatus.className = 'preview-status-past';
      previewStatus.textContent = 'Past Event';
    }
  }

  // Trigger on all relevant field changes
  ['f-title','f-subtitle','f-date','f-time','f-location','f-price','f-status','f-image'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', updatePreview);
    document.getElementById(id)?.addEventListener('change', updatePreview);
  });

  document.getElementById('f-title')?.addEventListener('input', (e) => {
    if (!editingSlug) setField('f-slug', slugify((e.target as HTMLInputElement).value));
  });

  newBtn.addEventListener('click', () => {
    clearForm();
    editingSlug = null;
    editingSha = null;
    updatePreview();
    openModal('New Class');
  });

  function openEdit(slug: string) {
    const cls = allClasses.find(c => c.slug === slug);
    if (!cls) return;
    editingSlug = slug;
    editingSha = cls._sha || null;
    clearForm();
    setField('f-title', cls.title || '');
    setField('f-subtitle', cls.subtitle || '');
    setField('f-slug', cls.slug || '');
    setField('f-type', cls.type || '');
    setField('f-status', cls.status || 'upcoming');
    setField('f-order', String(cls.order ?? ''));
    setField('f-date', cls.date || '');
    setField('f-time', cls.time || '');
    setField('f-duration', cls.duration || '');
    setField('f-location', cls.location || '');
    setField('f-address', cls.address || '');
    setField('f-price', String(cls.price ?? ''));
    setField('f-currency', cls.currency || 'GBP');
    setField('f-description', cls.description || '');
    setField('f-includes', (cls.includes || cls.included || []).join('\n'));
    setField('f-whatYouCreate', (cls.whatYouCreate || []).join('\n'));
    setField('f-skills', (cls.skills || []).join('\n'));
    setField('f-occasions', (cls.occasions || []).join('\n'));
    setField('f-image', cls.image || '');
    setField('f-coverImage', cls.coverImage || '');
    setField('f-gallery', (cls.gallery || []).join('\n'));
    updatePreview();
    openModal('Edit Class');
  }

  modalSave.addEventListener('click', async () => {
    const title = getField('f-title');
    const slug  = getField('f-slug');
    const date  = getField('f-date');
    const price = getField('f-price');
    const loc   = getField('f-location');
    const desc  = getField('f-description');
    const image = getField('f-image');

    if (!title || !slug || !date || !price || !loc || !desc || !image) {
      toast('Fill in all required fields (*)', false);
      return;
    }

    const classData: ClassItem = {
      slug, title, date,
      price: parseFloat(price),
      currency: getField('f-currency') || 'GBP',
      location: loc,
      description: desc,
      image,
      status: getField('f-status') || 'upcoming',
      ...(getField('f-subtitle') && { subtitle: getField('f-subtitle') }),
      ...(getField('f-time') && { time: getField('f-time') }),
      ...(getField('f-duration') && { duration: getField('f-duration') }),
      ...(getField('f-address') && { address: getField('f-address') }),
      ...(getField('f-coverImage') && { coverImage: getField('f-coverImage') }),
      ...(getField('f-type') && { type: getField('f-type') }),
      ...(getField('f-order') && { order: parseInt(getField('f-order')) }),
    };

    const includes = toLines(getField('f-includes'));
    if (includes.length) classData.includes = includes;
    const whatYouCreate = toLines(getField('f-whatYouCreate'));
    if (whatYouCreate.length) classData.whatYouCreate = whatYouCreate;
    const skills = toLines(getField('f-skills'));
    if (skills.length) classData.skills = skills;
    const occasions = toLines(getField('f-occasions'));
    if (occasions.length) classData.occasions = occasions;
    const gallery = toLines(getField('f-gallery'));
    if (gallery.length) classData.gallery = gallery;

    modalSave.disabled = true;
    modalSave.textContent = 'Pubblicazione…';

    const res = await fetch('/api/admin/classes', {
      method: editingSlug ? 'PATCH' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(editingSlug
        ? { ...classData, _sha: editingSha, _oldSlug: editingSlug }
        : classData),
    });

    modalSave.disabled = false;
    modalSave.textContent = 'Pubblica';

    if (res.ok) {
      toast(editingSlug ? 'Classe aggiornata!' : 'Classe pubblicata!');
      closeModal();
      deployNote.classList.add('show');
      await loadClasses();
    } else {
      const d = await res.json().catch(() => ({}));
      toast(d.error || 'Save failed. Try again.', false);
    }
  });

  async function deleteClass(slug: string, sha: string) {
    if (!confirm('Delete "' + slug + '"? This cannot be undone.')) return;
    const res = await fetch('/api/admin/classes', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug, sha }),
    });
    if (res.ok) {
      toast('Class deleted.');
      deployNote.classList.add('show');
      await loadClasses();
    } else {
      toast('Delete failed.', false);
    }
  }

  // ── IMAGE UPLOAD ──
  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const result = reader.result as string;
        resolve(result.split(',')[1]); // strip data:...;base64,
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  async function uploadFile(file: File): Promise<string | null> {
    const base64 = await fileToBase64(file);
    const res = await fetch('/api/admin/upload', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ filename: file.name, content: base64 }),
    });
    if (!res.ok) {
      const d = await res.json().catch(() => ({}));
      toast('Upload failed: ' + (d.error || res.status), false);
      return null;
    }
    const { path } = await res.json();
    return path;
  }

  function bindUpload(btnId: string, fileInputId: string, targetFieldId: string, multi = false) {
    const btn = document.getElementById(btnId) as HTMLButtonElement;
    const fileInput = document.getElementById(fileInputId) as HTMLInputElement;
    btn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      const files = Array.from(fileInput.files || []);
      if (!files.length) return;
      btn.disabled = true;
      btn.textContent = 'Uploading…';
      for (const file of files) {
        const path = await uploadFile(file);
        if (path) {
          if (multi) {
            const ta = document.getElementById(targetFieldId) as HTMLTextAreaElement;
            ta.value = ta.value ? ta.value + '\n' + path : path;
          } else {
            setField(targetFieldId, path);
          }
        }
      }
      btn.disabled = false;
      btn.textContent = multi ? 'Upload & Add to Gallery' : 'Upload';
      fileInput.value = '';
    });
  }

  bindUpload('upload-image-btn',   'upload-image-file',   'f-image');
  bindUpload('upload-cover-btn',   'upload-cover-file',   'f-coverImage');
  bindUpload('upload-gallery-btn', 'upload-gallery-file', 'f-gallery', true);

  init();
</script>

</body>
</html>
