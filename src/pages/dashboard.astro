---
export const prerender = false;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Spigadolce — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Lato', sans-serif; background: #f5f0eb; color: #3a2a1a; min-height: 100vh; }
    h1, h2, h3 { font-family: 'Playfair Display', serif; }
    ::-webkit-scrollbar { width: 6px; } ::-webkit-scrollbar-thumb { background: #ccc; border-radius: 3px; }

    /* Login */
    .login-wrap { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .login-box { background: #fff; padding: 2.5rem; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,.08); max-width: 380px; width: 90%; }
    .login-box h1 { font-size: 1.5rem; margin-bottom: 1.5rem; text-align: center; }
    .login-box input { width: 100%; padding: .75rem 1rem; border: 1px solid #d4c5b0; border-radius: 8px; font-size: 1rem; margin-bottom: 1rem; }
    .login-box button { width: 100%; padding: .75rem; background: #b8860b; color: #fff; border: none; border-radius: 8px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: background .2s; }
    .login-box button:hover { background: #9a7209; }
    .login-error { color: #c0392b; font-size: .875rem; margin-bottom: .75rem; display: none; text-align: center; }

    /* Shell */
    .shell { display: none; height: 100vh; grid-template-columns: 260px 1fr; grid-template-rows: 56px 1fr; }
    .shell.active { display: grid; }

    /* Top bar */
    .topbar { grid-column: 1 / -1; background: #3a2a1a; color: #fff; display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; }
    .topbar h1 { font-size: 1.1rem; font-family: 'Lato', sans-serif; font-weight: 700; letter-spacing: .5px; }
    .topbar-links a { color: #d4a849; text-decoration: none; font-size: .85rem; font-weight: 700; margin-left: 1.25rem; }
    .topbar-links a:hover { color: #f0c050; }

    /* Sidebar */
    .sidebar { background: #fff; border-right: 1px solid #e8e0d4; overflow-y: auto; padding: 1rem 0; }
    .sidebar-title { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #9a8a7a; padding: .75rem 1.25rem .4rem; }
    .sidebar-item { display: flex; align-items: center; justify-content: space-between; padding: .65rem 1.25rem; cursor: pointer; transition: background .15s; border-left: 3px solid transparent; }
    .sidebar-item:hover { background: #fdf6e8; }
    .sidebar-item.active { background: #fdf6e8; border-left-color: #b8860b; font-weight: 700; }
    .sidebar-item .name { font-size: .9rem; }
    .sidebar-item .count { font-size: .75rem; background: #eee; padding: .15rem .5rem; border-radius: 10px; color: #7a6a5a; }
    .sidebar-item.active .count { background: #b8860b; color: #fff; }
    .sidebar-sep { height: 1px; background: #e8e0d4; margin: .75rem 1.25rem; }
    .sidebar-item.settings .name { color: #9a8a7a; font-size: .85rem; }

    /* Content */
    .content { overflow-y: auto; padding: 1.5rem 2rem; background: #f5f0eb; }
    .content-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
    .content-header h2 { font-size: 1.5rem; }
    .content-actions { display: flex; gap: .5rem; }

    /* Buttons */
    .btn { padding: .5rem 1.1rem; border: none; border-radius: 8px; font-size: .85rem; font-weight: 700; cursor: pointer; transition: all .15s; display: inline-flex; align-items: center; gap: .4rem; }
    .btn-primary { background: #b8860b; color: #fff; }
    .btn-primary:hover { background: #9a7209; }
    .btn-outline { background: #fff; border: 1.5px solid #d4c5b0; color: #3a2a1a; }
    .btn-outline:hover { border-color: #b8860b; color: #b8860b; }
    .btn-danger { background: #e74c3c; color: #fff; }
    .btn-danger:hover { background: #c0392b; }
    .btn-sm { padding: .35rem .75rem; font-size: .8rem; }
    .btn:disabled { opacity: .5; cursor: not-allowed; }

    /* Entry cards */
    .entries-grid { display: grid; grid-template-columns: repeat(auto-fill, 230px); gap: 1rem; justify-content: start; }
    .entry-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.05); overflow: hidden; cursor: pointer; transition: transform .15s, box-shadow .15s; border: 2px solid transparent; }
    .entry-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.1); }
    .entry-card.selected { border-color: #b8860b; }
    .entry-img { width: 100%; height: 120px; object-fit: cover; background: #eee; display: block; }
    .entry-img-placeholder { width: 100%; height: 60px; background: linear-gradient(135deg, #e8e0d4, #d4c5b0); display: flex; align-items: center; justify-content: center; color: #9a8a7a; font-size: .8rem; }
    .entry-body { padding: .75rem 1rem; }
    .entry-title { font-size: .88rem; font-weight: 700; margin-bottom: .3rem; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .entry-meta { font-size: .75rem; color: #9a8a7a; display: flex; gap: .6rem; flex-wrap: wrap; }
    .entry-meta span { display: inline-flex; align-items: center; gap: .2rem; }

    /* Image upload */
    .img-dropzone { border: 2px dashed #d4c5b0; border-radius: 10px; padding: 1.25rem; text-align: center; cursor: pointer; transition: all .2s; background: #faf8f5; position: relative; }
    .img-dropzone:hover, .img-dropzone.dragover { border-color: #b8860b; background: #fdf6e8; }
    .img-dropzone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .img-dropzone .dz-text { color: #9a8a7a; font-size: .85rem; pointer-events: none; }
    .img-dropzone .dz-text strong { color: #b8860b; }
    .img-preview { margin-top: .75rem; position: relative; display: inline-block; }
    .img-preview img { max-height: 120px; border-radius: 8px; display: block; }
    .img-preview .img-path { font-size: .75rem; color: #7a6a5a; margin-top: .3rem; word-break: break-all; }
    .img-preview .img-remove { position: absolute; top: -6px; right: -6px; background: #e74c3c; color: #fff; border: none; border-radius: 50%; width: 22px; height: 22px; font-size: .8rem; cursor: pointer; line-height: 22px; text-align: center; }
    .img-uploading { color: #b8860b; font-size: .85rem; padding: .5rem 0; }

    /* Empty state */
    .empty-state { text-align: center; padding: 4rem 2rem; color: #9a8a7a; }
    .empty-state h3 { font-family: 'Lato', sans-serif; font-size: 1.1rem; margin-bottom: .5rem; color: #7a6a5a; }

    /* Loading */
    .loading { text-align: center; padding: 3rem; color: #9a8a7a; }
    .spinner { display: inline-block; width: 24px; height: 24px; border: 3px solid #e8e0d4; border-top-color: #b8860b; border-radius: 50%; animation: spin .6s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Modal */
    .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 100; align-items: flex-start; justify-content: center; padding: 3vh 1rem; overflow-y: auto; }
    .modal-overlay.active { display: flex; }
    .modal { background: #fff; border-radius: 16px; padding: 0; max-width: 680px; width: 100%; box-shadow: 0 12px 48px rgba(0,0,0,.2); overflow: hidden; }
    .modal-head { padding: 1.25rem 1.5rem; border-bottom: 1px solid #eee; display: flex; align-items: center; justify-content: space-between; }
    .modal-head h2 { font-size: 1.2rem; }
    .modal-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #999; padding: .25rem; }
    .modal-close:hover { color: #333; }
    .modal-body { padding: 1.5rem; max-height: 65vh; overflow-y: auto; }
    .modal-foot { padding: 1rem 1.5rem; border-top: 1px solid #eee; display: flex; gap: .75rem; justify-content: flex-end; }

    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-weight: 700; font-size: .85rem; margin-bottom: .3rem; color: #5a4a3a; }
    .form-group input, .form-group textarea, .form-group select { width: 100%; padding: .6rem .75rem; border: 1px solid #d4c5b0; border-radius: 8px; font-size: .9rem; font-family: 'Lato', sans-serif; }
    .form-group textarea { min-height: 80px; resize: vertical; }
    .form-group input:focus, .form-group textarea:focus { outline: none; border-color: #b8860b; box-shadow: 0 0 0 3px rgba(184,134,11,.1); }
    .form-hint { font-size: .75rem; color: #9a8a7a; margin-top: .2rem; }

    /* Fields editor in collection modal */
    .field-rows { margin-top: .5rem; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr 120px 36px; gap: .4rem; margin-bottom: .4rem; align-items: center; }
    .field-row input, .field-row select { padding: .45rem .6rem; font-size: .82rem; }
    .field-header { display: grid; grid-template-columns: 1fr 1fr 120px 36px; gap: .4rem; margin-bottom: .25rem; }
    .field-header span { font-size: .7rem; font-weight: 700; text-transform: uppercase; color: #9a8a7a; }
    .remove-btn { background: none; border: none; color: #ccc; font-size: 1.2rem; cursor: pointer; text-align: center; }
    .remove-btn:hover { color: #e74c3c; }

    /* Toast */
    .toast { position: fixed; bottom: 1.5rem; right: 1.5rem; padding: .75rem 1.5rem; border-radius: 10px; font-weight: 700; font-size: .9rem; box-shadow: 0 4px 20px rgba(0,0,0,.15); display: none; z-index: 200; color: #fff; }
    .toast.success { background: #27ae60; }
    .toast.error { background: #e74c3c; }
    .toast.active { display: block; }

    /* Collections view */
    .coll-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
    .coll-card { background: #fff; border-radius: 12px; padding: 1.25rem; box-shadow: 0 2px 12px rgba(0,0,0,.05); cursor: pointer; transition: all .15s; border: 2px solid transparent; }
    .coll-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.1); }
    .coll-card h3 { font-family: 'Lato', sans-serif; font-size: 1rem; font-weight: 700; margin-bottom: .25rem; }
    .coll-card p { font-size: .82rem; color: #9a8a7a; margin-bottom: .75rem; }
    .coll-card .coll-actions { display: flex; gap: .4rem; }
  </style>
</head>
<body>

  <!-- Login -->
  <div class="login-wrap" id="loginWrap">
    <div class="login-box">
      <h1>Dashboard</h1>
      <div class="login-error" id="loginError">Wrong password</div>
      <input type="password" id="loginPassword" placeholder="Password" autocomplete="current-password" />
      <button onclick="doLogin()">Enter</button>
    </div>
  </div>

  <!-- App Shell -->
  <div class="shell" id="shell">
    <div class="topbar">
      <h1>SPIGADOLCE</h1>
      <div class="topbar-links">
        <a href="/" target="_blank">View Site</a>
        <a href="/admin" target="_blank">Sveltia CMS</a>
      </div>
    </div>

    <div class="sidebar" id="sidebar"></div>

    <div class="content" id="content">
      <div class="loading"><div class="spinner"></div></div>
    </div>
  </div>

  <!-- Entry Modal -->
  <div class="modal-overlay" id="entryModal">
    <div class="modal">
      <div class="modal-head">
        <h2 id="entryModalTitle">Edit Entry</h2>
        <button class="modal-close" onclick="closeEntryModal()">&times;</button>
      </div>
      <div class="modal-body" id="entryModalBody"></div>
      <div class="modal-foot">
        <button class="btn btn-outline" onclick="closeEntryModal()">Cancel</button>
        <button class="btn btn-danger" id="entryDeleteBtn" onclick="deleteEntry()" style="display:none">Delete</button>
        <button class="btn btn-primary" id="entrySaveBtn" onclick="saveEntry()">Save</button>
      </div>
    </div>
  </div>

  <!-- Collection Modal -->
  <div class="modal-overlay" id="collModal">
    <div class="modal">
      <div class="modal-head">
        <h2 id="collModalTitle">Add Collection</h2>
        <button class="modal-close" onclick="closeCollModal()">&times;</button>
      </div>
      <div class="modal-body" id="collModalBody"></div>
      <div class="modal-foot">
        <button class="btn btn-outline" onclick="closeCollModal()">Cancel</button>
        <button class="btn btn-danger" id="collDeleteBtn" onclick="deleteColl()" style="display:none">Delete Collection</button>
        <button class="btn btn-primary" onclick="saveColl()">Save</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script is:inline>
    let password = '';
    let collections = [];
    let collSha = '';
    let currentView = null; // { type: 'entries', index: 0 } or { type: 'collections' }
    let entries = [];
    let editingEntry = null; // { index, path, sha } or null for new

    const WIDGETS = ['string','text','number','datetime','image','select','list','object','boolean','hidden'];

    // --- Auth ---
    function doLogin() {
      password = document.getElementById('loginPassword').value;
      loadCollections();
    }
    document.getElementById('loginPassword').addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });

    async function api(url, method, body) {
      const opts = { method, headers: { 'Authorization': 'Bearer ' + password, 'Content-Type': 'application/json' } };
      if (body) opts.body = JSON.stringify(body);
      return fetch(url, opts);
    }

    // --- Load collections ---
    async function loadCollections() {
      const res = await api('/api/collections', 'GET');
      if (!res.ok) { document.getElementById('loginError').style.display = 'block'; return; }
      const data = await res.json();
      collections = data.collections;
      collSha = data.sha;
      document.getElementById('loginWrap').style.display = 'none';
      document.getElementById('shell').classList.add('active');
      renderSidebar();
      if (collections.length > 0) selectCollection(0);
      else showCollectionsView();
    }

    // --- Sidebar ---
    function renderSidebar() {
      const sb = document.getElementById('sidebar');
      sb.innerHTML = `
        <div class="sidebar-title">Content</div>
        ${collections.filter(c => c.folder).map((c, i) => `
          <div class="sidebar-item ${currentView?.type === 'entries' && currentView.index === i ? 'active' : ''}" onclick="selectCollection(${i})">
            <span class="name">${c.label || c.name}</span>
            <span class="count" id="count-${i}">...</span>
          </div>
        `).join('')}
        <div class="sidebar-sep"></div>
        <div class="sidebar-title">Settings</div>
        <div class="sidebar-item settings ${currentView?.type === 'collections' ? 'active' : ''}" onclick="showCollectionsView()">
          <span class="name">Manage Collections</span>
        </div>
      `;
    }

    // --- Select collection (show entries) ---
    async function selectCollection(index) {
      currentView = { type: 'entries', index };
      renderSidebar();
      const c = collections[index];
      const content = document.getElementById('content');
      content.innerHTML = `
        <div class="content-header">
          <h2>${c.label || c.name}</h2>
          <div class="content-actions">
            <button class="btn btn-primary" onclick="openNewEntry()">+ New ${c.label || c.name}</button>
          </div>
        </div>
        <div class="loading"><div class="spinner"></div> Loading entries...</div>
      `;

      const res = await api('/api/entries?folder=' + encodeURIComponent(c.folder), 'GET');
      const data = await res.json();
      entries = data.entries || [];

      const countEl = document.getElementById('count-' + index);
      if (countEl) countEl.textContent = entries.length;

      if (entries.length === 0) {
        content.innerHTML = `
          <div class="content-header">
            <h2>${c.label || c.name}</h2>
            <div class="content-actions">
              <button class="btn btn-primary" onclick="openNewEntry()">+ New ${c.label || c.name}</button>
            </div>
          </div>
          <div class="empty-state">
            <h3>No entries yet</h3>
            <p>Create your first entry to get started.</p>
          </div>
        `;
        return;
      }

      const sorted = [...entries].sort((a, b) => (a.order || 999) - (b.order || 999));
      entries = sorted;

      content.innerHTML = `
        <div class="content-header">
          <h2>${c.label || c.name}</h2>
          <div class="content-actions">
            <button class="btn btn-primary" onclick="openNewEntry()">+ New ${c.label || c.name}</button>
          </div>
        </div>
        <div class="entries-grid">
          ${sorted.map((e, i) => {
            const img = e.image ? `<img class="entry-img" src="${e.image}" alt="" onerror="this.outerHTML='<div class=entry-img-placeholder>No image</div>'" />` : '<div class="entry-img-placeholder">No image</div>';
            const date = e.date || '';
            const excerpt = e.excerpt || e.description || '';
            return `<div class="entry-card" onclick="openEditEntry(${i})">
              ${img}
              <div class="entry-body">
                <div class="entry-title">${e.title || e.name || e.slug || 'Untitled'}</div>
                <div class="entry-meta">
                  ${date ? `<span>${date}</span>` : ''}
                  ${e.order != null ? `<span>Order: ${e.order}</span>` : ''}
                  ${e.category ? `<span>${e.category}</span>` : ''}
                </div>
              </div>
            </div>`;
          }).join('')}
        </div>
      `;
    }

    // --- Entry modal ---
    function getCollFields() {
      const c = collections[currentView.index];
      return c.fields || [];
    }

    function openNewEntry() {
      editingEntry = null;
      document.getElementById('entryModalTitle').textContent = 'New Entry';
      document.getElementById('entryDeleteBtn').style.display = 'none';
      renderEntryForm({});
      document.getElementById('entryModal').classList.add('active');
    }

    function openEditEntry(i) {
      const e = entries[i];
      editingEntry = { index: i, path: e.path, sha: e.sha };
      document.getElementById('entryModalTitle').textContent = 'Edit: ' + (e.title || e.slug || 'Entry');
      document.getElementById('entryDeleteBtn').style.display = 'inline-flex';
      renderEntryForm(e);
      document.getElementById('entryModal').classList.add('active');
    }

    function renderEntryForm(data) {
      const fields = getCollFields();
      const body = document.getElementById('entryModalBody');
      body.innerHTML = fields.map(f => {
        const val = data[f.name] ?? f.default ?? '';
        if (f.widget === 'hidden') {
          return `<input type="hidden" data-field="${f.name}" data-widget="hidden" value="${String(val).replace(/"/g, '&quot;')}" />`;
        }
        if (f.widget === 'text' || f.widget === 'markdown') {
          const textVal = Array.isArray(val) ? val.join('\n\n') : (val || '');
          return `<div class="form-group"><label>${f.label}</label><textarea data-field="${f.name}" data-widget="${f.widget}">${textVal}</textarea>${f.hint ? `<div class="form-hint">${f.hint}</div>` : ''}</div>`;
        }
        if (f.widget === 'number') {
          return `<div class="form-group"><label>${f.label}</label><input type="number" data-field="${f.name}" data-widget="number" value="${val}" />${f.hint ? `<div class="form-hint">${f.hint}</div>` : ''}</div>`;
        }
        if (f.widget === 'datetime') {
          return `<div class="form-group"><label>${f.label}</label><input type="date" data-field="${f.name}" data-widget="datetime" value="${val}" /></div>`;
        }
        if (f.widget === 'select' && f.options) {
          const opts = f.options.map(o => `<option value="${o}" ${o === val ? 'selected' : ''}>${o}</option>`).join('');
          return `<div class="form-group"><label>${f.label}</label><select data-field="${f.name}" data-widget="select"><option value="">— Select —</option>${opts}</select></div>`;
        }
        if (f.widget === 'list') {
          const items = Array.isArray(val) ? val : [];
          return `<div class="form-group"><label>${f.label}</label><div class="list-field" data-field="${f.name}" data-widget="list">${items.map((item, idx) => `<div style="display:flex;gap:.4rem;margin-bottom:.4rem;"><input value="${String(item).replace(/"/g, '&quot;')}" style="flex:1" /><button class="remove-btn" onclick="this.parentElement.remove()">&times;</button></div>`).join('')}</div><button class="btn btn-outline btn-sm" onclick="addListItem('${f.name}')" style="margin-top:.4rem;">+ Add</button></div>`;
        }
        if (f.widget === 'image') {
          const hasImg = val && val.length > 0;
          const previewHtml = hasImg ? `<div class="img-preview"><img src="${val}" alt="" /><button class="img-remove" onclick="clearImage('${f.name}')">&times;</button><div class="img-path">${val}</div></div>` : '';
          return `<div class="form-group"><label>${f.label}</label>
            <input type="hidden" data-field="${f.name}" data-widget="image" value="${val}" />
            <div class="img-dropzone" id="dz-${f.name}" ondragover="event.preventDefault();this.classList.add('dragover')" ondragleave="this.classList.remove('dragover')" ondrop="handleDrop(event,'${f.name}')">
              <input type="file" accept="image/*" onchange="handleFileSelect(this.files,'${f.name}')" />
              <div class="dz-text"><strong>Drop image here</strong> or click to browse</div>
            </div>
            <div id="preview-${f.name}">${previewHtml}</div>
            <div id="uploading-${f.name}"></div>
          </div>`;
        }
        return `<div class="form-group"><label>${f.label}</label><input type="text" data-field="${f.name}" data-widget="string" value="${String(val).replace(/"/g, '&quot;')}" /></div>`;
      }).join('');
    }

    function addListItem(fieldName) {
      const container = document.querySelector(`.list-field[data-field="${fieldName}"]`);
      const div = document.createElement('div');
      div.style.cssText = 'display:flex;gap:.4rem;margin-bottom:.4rem;';
      div.innerHTML = '<input value="" style="flex:1" /><button class="remove-btn" onclick="this.parentElement.remove()">&times;</button>';
      container.appendChild(div);
    }

    function collectFormData() {
      const fields = getCollFields();
      const data = {};
      fields.forEach(f => {
        if (f.widget === 'list') {
          const container = document.querySelector(`.list-field[data-field="${f.name}"]`);
          if (container) {
            data[f.name] = [...container.querySelectorAll('input')].map(inp => inp.value).filter(v => v);
          }
        } else {
          const el = document.querySelector(`[data-field="${f.name}"]`);
          if (!el) return;
          let val = el.value;
          if (f.widget === 'number') val = val ? Number(val) : 0;
          if (f.widget === 'text' && f.name === 'body') val = val.split(/\n\n+/).filter(p => p.trim());
          data[f.name] = val;
        }
      });
      // Auto-generate slug from title if empty
      if (data.title && (!data.slug || data.slug === '')) {
        data.slug = data.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      }
      return data;
    }

    async function saveEntry() {
      const data = collectFormData();
      const c = collections[currentView.index];
      document.getElementById('entrySaveBtn').disabled = true;

      if (editingEntry) {
        const res = await api('/api/entries', 'PUT', { path: editingEntry.path, sha: editingEntry.sha, content: data });
        if (!res.ok) { toast('Failed to save', true); document.getElementById('entrySaveBtn').disabled = false; return; }
      } else {
        const slug = data.slug || data.title?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/, '') || 'entry-' + Date.now();
        if (!data.slug) data.slug = slug;
        const filename = slug + '.json';
        const res = await api('/api/entries', 'POST', { folder: c.folder, filename, content: data });
        if (!res.ok) { toast('Failed to create', true); document.getElementById('entrySaveBtn').disabled = false; return; }
      }

      closeEntryModal();
      toast('Saved!');
      document.getElementById('entrySaveBtn').disabled = false;
      selectCollection(currentView.index);
    }

    async function deleteEntry() {
      if (!editingEntry) return;
      if (!confirm('Delete this entry permanently?')) return;
      const res = await api('/api/entries', 'DELETE', { path: editingEntry.path, sha: editingEntry.sha });
      if (!res.ok) { toast('Failed to delete', true); return; }
      closeEntryModal();
      toast('Deleted');
      selectCollection(currentView.index);
    }

    function closeEntryModal() { document.getElementById('entryModal').classList.remove('active'); }

    // --- Collections management view ---
    function showCollectionsView() {
      currentView = { type: 'collections' };
      renderSidebar();
      const content = document.getElementById('content');
      content.innerHTML = `
        <div class="content-header">
          <h2>Manage Collections</h2>
          <div class="content-actions">
            <button class="btn btn-primary" onclick="openAddColl()">+ Add Collection</button>
          </div>
        </div>
        <div class="coll-grid">
          ${collections.map((c, i) => {
            const isFile = !!c.files;
            const fieldCount = isFile ? (c.files[0]?.fields?.length || 0) : (c.fields?.length || 0);
            return `<div class="coll-card">
              <h3>${c.label || c.name}</h3>
              <p>${c.folder || 'File collection'} &middot; ${fieldCount} fields</p>
              <div class="coll-actions">
                <button class="btn btn-outline btn-sm" onclick="openEditColl(${i})">Edit</button>
              </div>
            </div>`;
          }).join('')}
        </div>
      `;
    }

    // --- Collection modal ---
    let editingColl = -1;

    function openAddColl() {
      editingColl = -1;
      document.getElementById('collModalTitle').textContent = 'Add Collection';
      document.getElementById('collDeleteBtn').style.display = 'none';
      renderCollForm({});
      document.getElementById('collModal').classList.add('active');
    }

    function openEditColl(i) {
      editingColl = i;
      const c = collections[i];
      document.getElementById('collModalTitle').textContent = 'Edit: ' + (c.label || c.name);
      document.getElementById('collDeleteBtn').style.display = 'inline-flex';
      renderCollForm(c);
      document.getElementById('collModal').classList.add('active');
    }

    function renderCollForm(c) {
      const fields = c.fields || (c.files && c.files[0]?.fields) || [];
      document.getElementById('collModalBody').innerHTML = `
        <div class="form-group"><label>Name (slug)</label><input type="text" id="cf-name" value="${c.name || ''}" ${editingColl >= 0 ? 'disabled' : ''} /></div>
        <div class="form-group"><label>Label</label><input type="text" id="cf-label" value="${c.label || ''}" /></div>
        <div class="form-group"><label>Content Folder</label><input type="text" id="cf-folder" value="${c.folder || ''}" placeholder="src/content/..." /></div>
        <div class="form-group"><label>Fields</label>
          <div class="field-header"><span>Label</span><span>Name</span><span>Widget</span><span></span></div>
          <div class="field-rows" id="cfFields">
            ${fields.map(f => `<div class="field-row">
              <input value="${f.label || ''}" /><input value="${f.name || ''}" />
              <select>${WIDGETS.map(w => `<option ${w === f.widget ? 'selected' : ''}>${w}</option>`).join('')}</select>
              <button class="remove-btn" onclick="this.parentElement.remove()">&times;</button>
            </div>`).join('')}
          </div>
          <button class="btn btn-outline btn-sm" onclick="addCollField()" style="margin-top:.5rem">+ Add Field</button>
        </div>
      `;
    }

    function addCollField() {
      const container = document.getElementById('cfFields');
      const row = document.createElement('div');
      row.className = 'field-row';
      row.innerHTML = `<input placeholder="Label" /><input placeholder="name" /><select>${WIDGETS.map(w => `<option>${w}</option>`).join('')}</select><button class="remove-btn" onclick="this.parentElement.remove()">&times;</button>`;
      container.appendChild(row);
    }

    async function saveColl() {
      const name = document.getElementById('cf-name').value.trim();
      const label = document.getElementById('cf-label').value.trim();
      const folder = document.getElementById('cf-folder').value.trim();
      const fieldRows = document.querySelectorAll('#cfFields .field-row');
      const fields = [...fieldRows].map(r => {
        const inputs = r.querySelectorAll('input, select');
        const fl = inputs[0].value.trim(), fn = inputs[1].value.trim(), fw = inputs[2].value;
        if (!fl || !fn) return null;
        const f = { label: fl, name: fn, widget: fw };
        if (fw === 'datetime') { f.format = 'YYYY-MM-DD'; f.date_format = 'YYYY-MM-DD'; f.time_format = false; }
        if (fw === 'list') { f.field = { label: fl + ' Item', name: 'item', widget: 'text' }; }
        return f;
      }).filter(Boolean);

      if (!name || !label) { toast('Name and label required', true); return; }

      if (editingColl === -1) {
        collections.push({ name, label, folder: folder || `src/content/${name}`, create: true, delete: true, extension: 'json', format: 'json', slug: '{{slug}}', sortable_fields: { fields: ['order','date','title'], default: { field: 'order' } }, fields });
      } else {
        const c = collections[editingColl];
        c.label = label;
        if (folder) c.folder = folder;
        if (c.fields) c.fields = fields;
        else if (c.files && c.files[0]) c.files[0].fields = fields;
      }

      const res = await api('/api/collections', 'PUT', { collections, sha: collSha });
      if (!res.ok) { toast('Failed to save', true); return; }
      const data = await res.json();
      collSha = data.sha;
      closeCollModal();
      renderSidebar();
      showCollectionsView();
      toast('Collection saved! CMS updates on next deploy.');
    }

    async function deleteColl() {
      if (editingColl < 0) return;
      if (!confirm('Remove this collection from the CMS? Content files are not deleted.')) return;
      collections.splice(editingColl, 1);
      const res = await api('/api/collections', 'PUT', { collections, sha: collSha });
      if (!res.ok) { toast('Failed to delete', true); return; }
      const data = await res.json();
      collSha = data.sha;
      closeCollModal();
      renderSidebar();
      showCollectionsView();
      toast('Collection removed');
    }

    function closeCollModal() { document.getElementById('collModal').classList.remove('active'); }

    // --- Toast ---
    // --- Image upload ---
    function handleDrop(e, fieldName) {
      e.preventDefault();
      e.currentTarget.classList.remove('dragover');
      const files = e.dataTransfer.files;
      if (files.length > 0) handleFileSelect(files, fieldName);
    }

    async function handleFileSelect(files, fieldName) {
      const file = files[0];
      if (!file || !file.type.startsWith('image/')) { toast('Please select an image file', true); return; }

      const uploadDiv = document.getElementById('uploading-' + fieldName);
      uploadDiv.innerHTML = '<div class="img-uploading"><div class="spinner" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;margin-right:.5rem;"></div>Uploading...</div>';

      const c = collections[currentView.index];
      const folderName = c.name || 'blog';

      const formData = new FormData();
      formData.append('file', file);
      formData.append('folder', folderName);

      const res = await fetch('/api/upload', {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + password },
        body: formData,
      });

      uploadDiv.innerHTML = '';

      if (!res.ok) { toast('Upload failed', true); return; }

      const data = await res.json();
      const path = data.path;

      document.querySelector(`[data-field="${fieldName}"]`).value = path;
      document.getElementById('preview-' + fieldName).innerHTML = `<div class="img-preview"><img src="${path}" alt="" /><button class="img-remove" onclick="clearImage('${fieldName}')">&times;</button><div class="img-path">${path}</div></div>`;
      toast('Image uploaded!');
    }

    function clearImage(fieldName) {
      document.querySelector(`[data-field="${fieldName}"]`).value = '';
      document.getElementById('preview-' + fieldName).innerHTML = '';
    }

    function toast(msg, isError) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast active ' + (isError ? 'error' : 'success');
      setTimeout(() => t.classList.remove('active'), 3000);
    }
  </script>
</body>
</html>
