---
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../content/pages/contact.json';
---

<BaseLayout title="Contact | Spigadolce" currentPath="/contact">
  <div class="contact-layout">
    <h1>{contact.title}</h1>
    <p class="subtitle">{contact.subtitle}</p>

    <div style="max-width: 600px; margin: 2rem auto; text-align: center;">
      <p style="font-size: 1.1rem; line-height: 1.8; color: var(--color-dark); margin-bottom: 2rem;">
        For demonstrations, collaborations, or any enquiry, send me an email and I'll get back to you as soon as possible.
      </p>

      <a href="mailto:spigadolce@gmail.com" class="btn-primary" style="font-size: 1rem; padding: 1rem 3rem;">
        Email Me
      </a>

      <p style="margin-top: 2rem; color: #888;">spigadolce@gmail.com</p>

      <hr style="margin: 2.5rem 0; border: none; border-top: 1px solid #ddd;" />

      <p style="font-size: 1rem; color: var(--color-dark); margin-bottom: 1rem;">Follow me on social media</p>
      <div style="display: flex; justify-content: center; gap: 1.5rem;">
        <a href="https://instagram.com/spigadolce" target="_blank" rel="noopener" style="color: #5f8f8b; font-weight: 600;">Instagram</a>
        <a href="https://facebook.com/spigadolce" target="_blank" rel="noopener" style="color: #5f8f8b; font-weight: 600;">Facebook</a>
        <a href="https://youtube.com/channel/UCv2jM3fCf42eru3XK86nSrQ" target="_blank" rel="noopener" style="color: #5f8f8b; font-weight: 600;">YouTube</a>
      </div>
    </div>
  </div>
</BaseLayout>
