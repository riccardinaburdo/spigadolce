---
import BaseLayout from '../layouts/BaseLayout.astro';
import contact from '../content/pages/contact.json';
---

<BaseLayout title="Contact | Spigadolce" currentPath="/contact">
  <div class="contact-layout">
    <h1>{contact.title}</h1>
    <p class="subtitle">{contact.subtitle}</p>

    <form class="contact-form" action="https://formspree.io/f/FORM_ID" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" />
        </div>
        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" />
        </div>
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <button type="submit">Send Message</button>
    </form>

    <div class="contact-info" style="text-align: center; margin-top: 2rem; color: #666;">
      <p>Or reach out directly at <a href="mailto:info@spigadolce.com" style="color: #5f8f8b;">info@spigadolce.com</a></p>
    </div>
  </div>
</BaseLayout>
