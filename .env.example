# Dashboard (/dashboard and /book-dashboard)
ADMIN_PASSWORD=...
# GitHub token used to commit content from the dashboard
GITHUB_TOKEN=ghp_...

# AI recipe generation (captions, ingredients, nutrition, health benefits)
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from https://dashboard.stripe.com/webhooks (after creating the webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Mailchimp
# Get from https://mailchimp.com/account/profile/ → Extras → API keys
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# Get from https://us21.admin.mailchimp.com/lists/ → click your list → Settings → List name and defaults
MAILCHIMP_LIST_ID=xxxxxxxxxx
